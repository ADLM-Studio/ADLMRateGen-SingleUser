<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:ADLMRateGen.Converters"
                    xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
                    xmlns:helpers="clr-namespace:ADLMRateGen.Helpers"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ─── BRUSHES & COLORS (Dark Mode) ─── -->
    <!-- Primary palette -->
    <Color x:Key="Blue900">#F3F8FF</Color>
    <Color x:Key="ButColCol">#2C74FF</Color>
    <Color x:Key="SignInCol">#4C8DFF</Color>
    <Color x:Key="NavyCol">#F3F8FF</Color>

    <!-- Neutrals & backgrounds -->
    <Color x:Key="WhiteCol">#071325</Color>
    <Color x:Key="BlackCol">#000000</Color>
    <Color x:Key="LightGrayCol">#0C1B31</Color>
    <Color x:Key="LighterGrayCol">#10233D</Color>
    <Color x:Key="InputBgCol">#0F2239</Color>
    <Color x:Key="RowAltCol">#0C1B31</Color>
    <Color x:Key="RowHoverCol">#112745</Color>
    <Color x:Key="HeaderBgCol">#0E223B</Color>
    <Color x:Key="HintGreyCol">#88A2C8</Color>
    <Color x:Key="Grey700Col">#B3C6E7</Color>
    <Color x:Key="DivCol">#18314F</Color>
    <Color x:Key="PopupBorderCol">#375A87</Color>
    <Color x:Key="ScrollbarTrackCol">#0E223A</Color>
    <Color x:Key="ScrollbarThumbCol">#234A7D</Color>
    <Color x:Key="ScrollbarThumbHoverCol">#35639F</Color>
    <Color x:Key="ScrollbarThumbPressedCol">#4C82C9</Color>

    <!-- Accent & states -->
    <Color x:Key="HoverLightCol">#10233D</Color>
    <Color x:Key="ActiveBgCol">#132A46</Color>
    <Color x:Key="PressedBgCol">#173557</Color>
    <Color x:Key="DisabledBgCol">#0C1A2E</Color>
    <Color x:Key="DisabledFgCol">#7B93B5</Color>
    <Color x:Key="CheckedBgCol">#10233D</Color>
    <Color x:Key="CheckedFgCol">#FFFFFF</Color>
    <Color x:Key="DarkHoverCol">#4C8DFF</Color>
    <Color x:Key="DarkButtonCol">#173A67</Color>
    <Color x:Key="DarkButtonHoverCol">#1F4C87</Color>
    <Color x:Key="MouseOverCellCol">#163154</Color>
    <Color x:Key="SelectedCellCol">#214B7E</Color>
    <Color x:Key="SecondaryTextCol">#E7F0FF</Color>
    <Color x:Key="HeaderTextCol">#F3F8FF</Color>

    <!-- 🎨 ADLM Color Palette (Centralized) -->
    <Color x:Key="Color.Primary">#FF1E90FF</Color>
    <Color x:Key="Color.Dark">#091E39</Color>
    <Color x:Key="Color.Light">#FF87CEFA</Color>
    <Color x:Key="Color.Success">#838D92</Color>
    <Color x:Key="Color.DeepGreen">#FF006400</Color>
    <Color x:Key="Color.Danger">#FFFF4500</Color>
    <Color x:Key="Color.White">#313E45</Color>
    <Color x:Key="Color.Gray">#8CA6B6</Color>
    <Color x:Key="Color.RowAlt">#66757D</Color>
    <Color x:Key="OrangeAccentCol">#FF5900</Color>
    <Color x:Key="OrangeAccentHoverCol">#FFE8B3</Color>

    <!-- 🎨 Brush Library -->
    <SolidColorBrush x:Key="PrimaryBrush"
                     Color="{DynamicResource Color.Primary}" />
    <SolidColorBrush x:Key="DarkBrush"
                     Color="{DynamicResource Color.Dark}" />
    <SolidColorBrush x:Key="HoverBrush"
                     Color="{DynamicResource Color.Light}" />
    <SolidColorBrush x:Key="SuccessBrush"
                     Color="{DynamicResource Color.Success}" />
    <SolidColorBrush x:Key="DangerBrush"
                     Color="{DynamicResource Color.Danger}" />
    <SolidColorBrush x:Key="HeaderBrush"
                     Color="{DynamicResource Color.Dark}" />
    <SolidColorBrush x:Key="AltRowBrush"
                     Color="{DynamicResource Color.RowAlt}" />
    <SolidColorBrush x:Key="OrangeAccentBrush"
                     Color="{DynamicResource OrangeAccentCol}" />
    <SolidColorBrush x:Key="OrangeAccentHoverBrush"
                     Color="{DynamicResource OrangeAccentHoverCol}" />





    <!-- Brushes -->
    <SolidColorBrush x:Key="Blue900Brush"
                     Color="{DynamicResource Blue900}" />
    <SolidColorBrush x:Key="ButCol"
                     Color="{DynamicResource ButColCol}" />
    <SolidColorBrush x:Key="SignInBrush"
                     Color="{DynamicResource SignInCol}" />
    <SolidColorBrush x:Key="Navy"
                     Color="{DynamicResource NavyCol}" />

    <SolidColorBrush x:Key="BackgroundBrush"
                     Color="{DynamicResource WhiteCol}" />
    <SolidColorBrush x:Key="PrimaryBrush2"
                     Color="{DynamicResource BlackCol}" />
    <SolidColorBrush x:Key="BorderBrushLight"
                     Color="{DynamicResource DivCol}" />
    <SolidColorBrush x:Key="Grey700"
                     Color="{DynamicResource Grey700Col}" />
    <SolidColorBrush x:Key="HintGrey"
                     Color="{DynamicResource HintGreyCol}" />
    <SolidColorBrush x:Key="LightGrayBrush"
                     Color="{DynamicResource LightGrayCol}" />
    <SolidColorBrush x:Key="MainBg"
                     Color="{DynamicResource DivCol}" />
    <SolidColorBrush x:Key="BgInput"
                     Color="{DynamicResource InputBgCol}" />
    <SolidColorBrush x:Key="RowAlt"
                     Color="{DynamicResource RowAltCol}" />
    <SolidColorBrush x:Key="RowHover"
                     Color="{DynamicResource RowHoverCol}" />
    <SolidColorBrush x:Key="HeaderBgBrush"
                     Color="{DynamicResource HeaderBgCol}" />
    <SolidColorBrush x:Key="HeaderTextBrush"
                     Color="{DynamicResource HeaderTextCol}" />
    <SolidColorBrush x:Key="CellTextBrush"
                     Color="{DynamicResource SecondaryTextCol}" />
    <SolidColorBrush x:Key="DataPrimaryBrush"
                     Color="{DynamicResource LightGrayCol}" />

    <SolidColorBrush x:Key="HoverLightBrush"
                     Color="{DynamicResource HoverLightCol}" />
    <SolidColorBrush x:Key="ActiveBgBrush"
                     Color="{DynamicResource ActiveBgCol}" />
    <SolidColorBrush x:Key="PressedBgBrush"
                     Color="{DynamicResource PressedBgCol}" />
    <SolidColorBrush x:Key="DisabledBgBrush"
                     Color="{DynamicResource DisabledBgCol}" />
    <SolidColorBrush x:Key="DisabledFgBrush"
                     Color="{DynamicResource DisabledFgCol}" />
    <SolidColorBrush x:Key="CheckedBgBrush"
                     Color="{DynamicResource CheckedBgCol}" />
    <SolidColorBrush x:Key="CheckedFgBrush"
                     Color="{DynamicResource CheckedFgCol}" />
    <SolidColorBrush x:Key="DarkHoverBrush"
                     Color="{DynamicResource DarkHoverCol}" />
    <SolidColorBrush x:Key="DarkButtonBrush"
                     Color="{DynamicResource DarkButtonCol}" />
    <SolidColorBrush x:Key="DarkButtonHoverBrush"
                     Color="{DynamicResource DarkButtonHoverCol}" />
    <SolidColorBrush x:Key="MouseOverCellBrush"
                     Color="{DynamicResource MouseOverCellCol}" />
    <SolidColorBrush x:Key="SelectedCellBrush"
                     Color="{DynamicResource SelectedCellCol}" />
    <SolidColorBrush x:Key="PopupBorderBrush"
                     Color="{DynamicResource PopupBorderCol}" />
    <SolidColorBrush x:Key="ScrollbarTrackBrush"
                     Color="{DynamicResource ScrollbarTrackCol}" />
    <SolidColorBrush x:Key="ScrollbarThumbBrush"
                     Color="{DynamicResource ScrollbarThumbCol}" />
    <SolidColorBrush x:Key="ScrollbarThumbHoverBrush"
                     Color="{DynamicResource ScrollbarThumbHoverCol}" />
    <SolidColorBrush x:Key="ScrollbarThumbPressedBrush"
                     Color="{DynamicResource ScrollbarThumbPressedCol}" />

    <!-- ─── FONTS ─── -->
    <FontFamily x:Key="Mont">Poppins</FontFamily>
    <FontFamily x:Key="PoppinsFont">Poppins</FontFamily>

    <!-- ─── CONVERTERS ─── -->
    <conv:PercentConverter x:Key="PercentConverter" />

    <!-- ─── EFFECTS ─── -->
    <DropShadowEffect x:Key="SoftShadow"
                      Color="{DynamicResource BlackCol}"
                      BlurRadius="10"
                      ShadowDepth="0"
                      Opacity="0.12" />
    <Style x:Key="RightGroupItemMargin"
           TargetType="FrameworkElement">
        <Setter Property="Margin"
                Value="0,0,16,0" />
    </Style>


    <!-- ─── ICON BUTTONS ─── -->
    <Style x:Key="IconButton"
           TargetType="Button">
        <Setter Property="Width"
                Value="34" />
        <Setter Property="Height"
                Value="34" />
        <Setter Property="FontFamily"
                Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize"
                Value="18" />
        <Setter Property="Content"
                Value="" />
        <Setter Property="Foreground"
                Value="{DynamicResource Blue900Brush}" />
        <Setter Property="Background"
                Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="Cursor"
                Value="Hand" />
    </Style>

    <!-- ─── NAVIGATION BUTTONS ─── -->
    <Style x:Key="NavFlatButton"
           TargetType="Button">
        <Setter Property="Background"
                Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="HorizontalContentAlignment"
                Value="Left" />
        <Setter Property="Padding"
                Value="12,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="root"
                                    Property="Background"
                                    Value="{DynamicResource HoverLightBrush}" />
                        </Trigger>
                        <Trigger Property="helpers:ButtonHelper.IsActive"
                                 Value="True">
                            <Setter TargetName="root"
                                    Property="Background"
                                    Value="{DynamicResource ActiveBgBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource CheckedFgBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavPrimaryButton"
           TargetType="Button">
        <Setter Property="Background"
                Value="{DynamicResource DarkButtonBrush}" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="14,8">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─── TOP NAVIGATION STYLES ─── -->
    <Style x:Key="TopNavButtonStyle"
           TargetType="Button">
        <Setter Property="Background"
                Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource CheckedFgBrush}" />
        <Setter Property="BorderThickness"
                Value="1.2" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="Margin"
                Value="4" />
        <Setter Property="Padding"
                Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TopNavComboBoxStyle"
           TargetType="ComboBox">
        <Setter Property="Background"
                Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="Foreground"
                Value="{DynamicResource CellTextBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource BorderBrushLight}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="FontFamily"
                Value="{DynamicResource PoppinsFont}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment"
                Value="Left" />
        <Setter Property="Padding"
                Value="12,4" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground"
                            Value="{DynamicResource CellTextBrush}" />
                    <Setter Property="Background"
                            Value="{DynamicResource BackgroundBrush}" />
                    <Setter Property="FontFamily"
                            Value="{DynamicResource PoppinsFont}" />
                    <Setter Property="FontSize"
                            Value="13" />
                    <Setter Property="Padding"
                            Value="12,8" />
                    <Setter Property="HorizontalContentAlignment"
                            Value="Left" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="ItemRoot"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="8"
                                        Margin="4,2"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted"
                                             Value="True">
                                        <Setter TargetName="ItemRoot"
                                                Property="Background"
                                                Value="{DynamicResource HoverLightBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected"
                                             Value="True">
                                        <Setter TargetName="ItemRoot"
                                                Property="Background"
                                                Value="{DynamicResource ActiveBgBrush}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource Blue900Brush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <ContentPresenter x:Name="ContentSite"
                                                  Margin="8,0,28,0"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                <TextBlock Text="⌄"
                                           FontFamily="Segoe MDL2 Assets"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,12,0"
                                           Foreground="{TemplateBinding Foreground}" />
                                <ToggleButton x:Name="DropDownToggle"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              HorizontalAlignment="Right"
                                              Width="28"
                                              Background="{DynamicResource BackgroundBrush}"
                                              BorderBrush="{DynamicResource BackgroundBrush}" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border x:Name="PopupBorder"
                                    Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrushLight}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,4,0,0">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{DynamicResource HoverLightBrush}" />
                        </Trigger>
                        <Trigger Property="HasItems"
                                 Value="False">
                            <Setter TargetName="PopupBorder"
                                    Property="MinHeight"
                                    Value="95" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource PopupBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─── TEXTBLOCK STYLES ─── -->
    <Style x:Key="Headline"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource Mont}" />
        <Setter Property="FontSize"
                Value="36" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="Foreground"
                Value="{DynamicResource HintGrey}" />
    </Style>

    <Style x:Key="Body"
           TargetType="TextBlock"
           BasedOn="{StaticResource Headline}">
        <Setter Property="FontFamily"
                Value="{DynamicResource Mont}" />
        <Setter Property="FontSize"
                Value="20" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource Blue900Brush}" />
    </Style>

    <Style x:Key="MainHeadingText"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource Mont}" />
        <Setter Property="FontSize"
                Value="52" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="Foreground"
                Value="{DynamicResource Blue900Brush}" />
    </Style>

    <Style x:Key="SubheadingText"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource Mont}" />
        <Setter Property="FontSize"
                Value="18" />
        <Setter Property="FontWeight"
                Value="Normal" />
        <Setter Property="Foreground"
                Value="{DynamicResource Grey700}" />
    </Style>

    <Style x:Key="BtnText"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="19" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="TextAlignment"
                Value="Center" />
        <Setter Property="Foreground"
                Value="{DynamicResource BackgroundBrush}" />
    </Style>

    <Style x:Key="BtnSidebarText"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="Poppins" />
        <Setter Property="FontSize"
                Value="16" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="Foreground"
                Value="{DynamicResource Blue900Brush}" />
        <Setter Property="MaxWidth"
                Value="120" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="OPText"
           TargetType="TextBlock">
        <Setter Property="Text"
                Value="%" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="HorizontalAlignment"
                Value="Right" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="0,0,12,0" />
        <Setter Property="Foreground"
                Value="{DynamicResource Grey700}" />
    </Style>

    <Style x:Key="OOText"
           TargetType="TextBlock">
        <Setter Property="Text"
                Value="overhead " />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="HorizontalAlignment"
                Value="Left" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="0,0,12,0" />
        <Setter Property="Foreground"
                Value="{DynamicResource Grey700}" />
    </Style>

    <Style x:Key="OSPText"
           TargetType="TextBlock">
        <Setter Property="Text"
                Value="profit " />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="HorizontalAlignment"
                Value="Left" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="0,0,12,0" />
        <Setter Property="Foreground"
                Value="{DynamicResource Grey700}" />
    </Style>

    <Style x:Key="CenterCellText"
           TargetType="TextBlock">
        <!-- this will make your Quantity/Unit/Price columns centered -->
        <Setter Property="FontFamily"
                Value="{DynamicResource PoppinsFont}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="Foreground"
                Value="{DynamicResource CellTextBrush}" />
        <Setter Property="VerticalAlignment"
                Value="Center" />

        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CenterCellNr"
           TargetType="TextBlock">
        <!-- this will make your Quantity/Unit/Price columns centered -->
        <Setter Property="FontFamily"
                Value="{DynamicResource PoppinsFont}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="Foreground"
                Value="{DynamicResource CellTextBrush}" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="WrapCellText"
           TargetType="TextBlock">
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="0" />
    </Style>

    <Style x:Key="TableDescriptionText"
           TargetType="TextBlock"
           BasedOn="{StaticResource CenterCellText}">
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
        <Setter Property="LineHeight"
                Value="20" />
        <Setter Property="MaxHeight"
                Value="40" />
        <Setter Property="Margin"
                Value="0,6,12,6" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="EstHeader"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource Mont}" />
        <Setter Property="FontSize"
                Value="52" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="Foreground"
                Value="{DynamicResource Blue900Brush}" />
    </Style>

    <Style x:Key="EstSubheader"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource Mont}" />
        <Setter Property="FontSize"
                Value="18" />
        <Setter Property="Foreground"
                Value="{DynamicResource Grey700}" />
    </Style>

    <!-- ─── TEXTBOX STYLES ─── -->
    <Style x:Key="HollowBox"
           TargetType="TextBox">
        <Setter Property="Background"
                Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource BorderBrushLight}" />
        <Setter Property="Foreground"
                Value="{DynamicResource CellTextBrush}" />
        <Setter Property="BorderThickness"
                Value="1.2" />
        <Setter Property="FontFamily"
                Value="{DynamicResource Mont}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="Height"
                Value="46" />
        <Setter Property="Padding"
                Value="14,0" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border CornerRadius="12"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OPTextBox"
           TargetType="TextBox"
           BasedOn="{StaticResource HollowBox}">
        <Setter Property="Background"
                Value="{DynamicResource DisabledBgBrush}" />
        <Setter Property="Padding"
                Value="14,0,34,0" />
    </Style>

    <Style x:Key="RoundedTextBox"
           TargetType="TextBox">
        <Setter Property="Background"
                Value="#636A6E" />
        <Setter Property="Foreground"
                Value="{DynamicResource CellTextBrush}" />
        <Setter Property="BorderBrush"
                Value="#CBD5E0" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Padding"
                Value="12" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SearchBoxWithIcon"
           TargetType="TextBox"
           BasedOn="{StaticResource HollowBox}">
        <Setter Property="Padding"
                Value="44,0,12,0" />
        <Setter Property="Foreground"
                Value="{DynamicResource CellTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
