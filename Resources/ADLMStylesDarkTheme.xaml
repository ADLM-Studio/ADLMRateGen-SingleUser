    <!-- The quiet half of a pair. Same shape and height as PrimaryButton so the
         two sit level, but outlined rather than filled, because the pair asks a
         question and neither answer should shout over the other. -->
    <!-- The mark applied to a CAPTURED image rather than to the screen. Heavier
         than the on-screen brush: nobody is trying to read figures through it,
         and it has to survive being cropped, resized and re-compressed. -->
    <ImageBrush x:Key="WatermarkStampBrush"
                ImageSource="/Resources/adlm_rate_generator_logo_small.png"
                Opacity="0.08"
                TileMode="Tile"
                Viewbox="-0.34,-0.34,1.68,1.68"
                ViewboxUnits="RelativeToBoundingBox"
                Viewport="0,0,360,360"
                ViewportUnits="Absolute"
                Stretch="Uniform"
                AlignmentX="Center"
                AlignmentY="Center">
        <ImageBrush.RelativeTransform>
            <RotateTransform Angle="-30" CenterX="0.5" CenterY="0.5" />
        </ImageBrush.RelativeTransform>
    </ImageBrush>

    <!-- Screen watermark. Tiled and rotated so it cannot be cropped out of a
         partial capture, and drawn in the app itself rather than stamped onto a
         screenshot afterwards: no Windows API lets a process reach into what
         Snipping Tool or a phone camera captured, so the only mark that reliably
         survives every route off the screen is one that is genuinely on it.

         Opacity is a compromise — high enough to read in a photograph of the
         monitor, low enough not to fight the figures underneath. The asset is
         per-theme because a navy logo at this opacity vanishes on a dark page. -->
    <ImageBrush x:Key="WatermarkBrush"
                ImageSource="/Resources/adlm_rate_generator_logo_small.png"
                Opacity="0.08"
                TileMode="Tile"
                Viewbox="-0.34,-0.34,1.68,1.68"
                ViewboxUnits="RelativeToBoundingBox"
                Viewport="0,0,440,440"
                ViewportUnits="Absolute"
                Stretch="Uniform"
                AlignmentX="Center"
                AlignmentY="Center">
        <ImageBrush.RelativeTransform>
            <RotateTransform Angle="-30" CenterX="0.5" CenterY="0.5" />
        </ImageBrush.RelativeTransform>
    </ImageBrush>

