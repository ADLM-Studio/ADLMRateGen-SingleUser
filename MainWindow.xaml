<Window x:Class="ADLMRateGen.MainWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ADLMRateGen.ViewModel"
        xmlns:view="clr-namespace:ADLMRateGen.View"
        xmlns:controls="clr-namespace:ADLMCivilPlugin.Controls"
        xmlns:ground="clr-namespace:ADLMRateGen.ViewModel.Groundwork"
        xmlns:concrete="clr-namespace:ADLMRateGen.ViewModel.ConcreteWork"
        xmlns:blockwork="clr-namespace:ADLMRateGen.ViewModel.BlockWork"
        xmlns:mepwork="clr-namespace:ADLMRateGen.ViewModel.MepWork"
        xmlns:finishes="clr-namespace:ADLMRateGen.ViewModel.Finishes"
        xmlns:roof="clr-namespace:ADLMRateGen.ViewModel.RoofWork"
        xmlns:windowAndDoor="clr-namespace:ADLMRateGen.ViewModel.WindowAndDoor"
        xmlns:paint="clr-namespace:ADLMRateGen.ViewModel.Painting"
        xmlns:carbon="clr-namespace:ADLMRateGen.ViewModel.CarbonOthers"
        xmlns:billpricing="clr-namespace:ADLMRateGen.ViewModel.BillPricing"
        xmlns:steel="clr-namespace:ADLMRateGen.ViewModel.SteelWork"
        xmlns:customInput="clr-namespace:ADLMRateGen.ViewModel.CustomRate"
        xmlns:helpers="clr-namespace:ADLMRateGen.Helpers"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:conv="clr-namespace:ADLMRateGen.Converters"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        xmlns:suite="clr-namespace:ADLMRateGen.Controls"
        xmlns:suiteView="clr-namespace:ADLMRateGen.View.Suite"
        mc:Ignorable="d"
        Title="ADLM Rate Gen"
        WindowStyle="SingleBorderWindow"
        Width="1440"
        Height="900"
        MinWidth="860"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SxBgAlt}">
    <!-- ───────── RESOURCES ───────── -->
    <Window.Resources>
        <ResourceDictionary>
            <conv:FirstNameConverter x:Key="FirstNameConv" />
            <!-- ── VIEW  DATA-TEMPLATES  (unchanged) ── -->
            <DataTemplate DataType="{x:Type vm:SignInViewModel}">
                <view:SignInUserControl />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MaterialLibraryViewModel}">
                <view:MaterialLibraryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MaterialPriceViewModel}">
                <view:MaterialPriceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LabourLibraryViewModel}">
                <view:LabourLibraryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LabourPriceViewModel}">
                <view:LabourPriceView />
            </DataTemplate>
            <!-- discipline templates -->
            <DataTemplate DataType="{x:Type ground:GroundWorkViewModel}">
                <view:GroundWorkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type concrete:ConcreteViewModel}">
                <view:ConcreteWorkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type blockwork:BlockworkViewModel}">
                <view:BlockworkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type mepwork:MepWorkViewModel}">
                <view:MepWorkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type finishes:FinishesViewModel}">
                <view:FinishesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type roof:RoofWorkViewModel}">
                <view:RoofworkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type windowAndDoor:WindowAndDoorViewModel}">
                <view:WindowAndDoorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type paint:PaintWorkViewModel}">
                <view:PaintworkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type steel:SteelWorkViewModel}">
                <view:SteelworkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type billpricing:BillPricingViewModel}">
                <view:BillPricingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type carbon:CarbonOthersViewModel}">
                <view:CarbonOthersView />
            </DataTemplate>
            <!-- custom-rate -->
            <DataTemplate DataType="{x:Type customInput:CustomRateEntryViewModel}">
                <view:CustomRateEntryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type customInput:CustomRateListViewModel}">
                <view:CustomRateListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LibraryShellViewModel}">
                <view:LibraryShellView />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <!-- ───────── MAIN LAYOUT ─────────
         The suite's shell (Richard's design, 30 Sep 2026): the inset rail, the
         56px top bar, and the work area on bg-alt with the banner as its first
         card. The same shell as HERON and the Installer Hub. -->
    <Grid UseLayoutRounding="True"
          SnapsToDevicePixels="True">
            <!-- Sign-in overlay -->
            <ContentControl Content="{Binding SignInViewModel}"
                            Visibility="{Binding DataContext.IsLoggedIn,
                                                 ElementName=Root,
                                                 Converter={StaticResource InvBoolVis}}" />
            <!-- Logged-in shell -->
            <Grid x:Name="MainLayout"
                  TextElement.FontFamily="{StaticResource SxFont}"
                  Visibility="{Binding DataContext.IsLoggedIn,
                                       ElementName=Root,
                                       Converter={StaticResource BoolVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="236" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--────────  RAIL  ─────────-->
                <Border Grid.RowSpan="2"
                        Background="{DynamicResource SxBgInset}"
                        BorderBrush="{DynamicResource SxLine}"
                        BorderThickness="0,0,1,0"
                        Padding="12,16">
                    <DockPanel LastChildFill="True">
                        <!-- Brand. Ctrl+B folds the rail to its icons. -->
                        <Grid DockPanel.Dock="Top" Margin="6,2,0,16">
                            <Image Source="{DynamicResource SxLogo}" Width="118" HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                            <Button Style="{StaticResource SxIconBtn}" Width="28" Height="28"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Tag="{DynamicResource SxBg}"
                                    Command="{Binding ToggleSidebarCommand}"
                                    ToolTip="Fold or unfold the rail (Ctrl+B)">
                                <Grid>
                                    <Path Data="M14,6 L8,12 L14,18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="24" Height="24" RenderTransformOrigin="0.5,0.5"
                                          Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                    <Path Data="M10,6 L16,12 L10,18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="24" Height="24"
                                          Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource BoolVis}}" />
                                </Grid>
                            </Button>
                        </Grid>

                        <Button DockPanel.Dock="Top" Style="{StaticResource SxRailLib}"
                                Command="{Binding SelectedMaterialLibraryViewCommand}"
                                ToolTip="Library (Ctrl+1)">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Library}" />
                                <TextBlock Text="Library" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                            </StackPanel>
                        </Button>

                        <!-- Foot: leaves the rates, rather than moving between them -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button Style="{StaticResource SxRailFoot}" Click="ToCmApp_Click" ToolTip="RateGen on the web, where these rates price your projects">
                            <Grid>
                                <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Cloud}"
                                                Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource BoolVis}}" />
                                <TextBlock Text="Open ADLM Cloud" Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource SxRailFoot}" Command="{Binding ExportAllRatesCommand}" ToolTip="Export every rate to Excel (Ctrl+E)"
                                Visibility="{Binding IsExportVisible, Converter={StaticResource BoolVis}, FallbackValue=Visible}">
                            <Grid>
                                <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Excel}"
                                                Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource BoolVis}}" />
                                <TextBlock Text="Export" Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource SxRailFoot}" Command="{Binding HelpCommand}" ToolTip="Help">
                            <Grid>
                                <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Help}"
                                                Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource BoolVis}}" />
                                <TextBlock Text="Help" Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource SxRailFoot}" Command="{Binding LogoutCommand}" ToolTip="Log out. Your custom rates stay on this PC."
                                Foreground="{DynamicResource SxAccent}">
                            <Grid>
                                <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Signout}"
                                                Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource BoolVis}}" />
                                <TextBlock Text="Log out" Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                            </Grid>
                        </Button>
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SxRailHead}" Text="ITEM OF WORKS"
                                   Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                            <Button Style="{StaticResource SxRailNav}"
                                    Command="{Binding SelectedGroundworkViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsGroundworkActive}"
                                    ToolTip="Ground (Ctrl+2)">
                                <DockPanel>
                                    <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Ground}" />
                                    <TextBlock Text="Ground" Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource SxRailNav}"
                                    Command="{Binding SelectedConcreteWorkViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsConcreteViewActive}"
                                    ToolTip="Concrete (Ctrl+3)">
                                <DockPanel>
                                    <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Concrete}" />
                                    <TextBlock Text="Concrete" Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource SxRailNav}"
                                    Command="{Binding SelectedBlockworkViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsBlockworkActive}"
                                    ToolTip="Block Works (Ctrl+4)">
                                <DockPanel>
                                    <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Block}" />
                                    <TextBlock Text="Block Works" Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource SxRailNav}"
                                    Command="{Binding SelectedFinishesViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsFinishesActive}"
                                    ToolTip="Finishes (Ctrl+5)">
                                <DockPanel>
                                    <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Finishes}" />
                                    <TextBlock Text="Finishes" Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource SxRailNav}"
                                    Command="{Binding SelectedRoofworkViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsRoofworkActive}"
                                    ToolTip="Roofs (Ctrl+6)">
                                <DockPanel>
                                    <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Roofs}" />
                                    <TextBlock Text="Roofs" Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource SxRailNav}"
                                    Command="{Binding SelectedPaintworkViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsPaintingActive}"
                                    ToolTip="Painting (Ctrl+7)">
                                <DockPanel>
                                    <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Paint}" />
                                    <TextBlock Text="Painting" Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource SxRailNav}"
                                    Command="{Binding SelectedSteelworkViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsSteelworkActive}"
                                    ToolTip="Steel (Ctrl+8)">
                                <DockPanel>
                                    <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Steelwork}" />
                                    <TextBlock Text="Steel" Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource SxRailNav}"
                                    Command="{Binding SelectedWindowAndDoorViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsWindowAndDoorActive}"
                                    ToolTip="Window and Door (Ctrl+9)">
                                <DockPanel>
                                    <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Openings}" />
                                    <TextBlock Text="Window and Door" Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </DockPanel>
                            </Button>
                            <TextBlock Style="{StaticResource SxRailHead}" Text="SERVICES" Margin="10,14,0,6"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                            <Button Style="{StaticResource SxRailNav}"
                                    Command="{Binding SelectedMechanicalViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsMechanicalActive}"
                                    ToolTip="Mechanical services: air conditioning and ventilation">
                                <DockPanel>
                                    <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Mechanical}" />
                                    <TextBlock Text="Mechanical" Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource SxRailNav}"
                                    Command="{Binding SelectedElectricalViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsElectricalActive}"
                                    ToolTip="Electrical services: lighting, power, cables, earthing, containment, security">
                                <DockPanel>
                                    <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Electrical}" />
                                    <TextBlock Text="Electrical" Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource SxRailNav}"
                                    Command="{Binding SelectedPlumbingViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsPlumbingActive}"
                                    ToolTip="Plumbing: water supply, soil and waste, rainwater, sanitary">
                                <DockPanel>
                                    <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Plumbing}" />
                                    <TextBlock Text="Plumbing" Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource SxRailNav}"
                                    Command="{Binding SelectedFireViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsFireActive}"
                                    ToolTip="Fire protection and alarm">
                                <DockPanel>
                                    <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Fire}" />
                                    <TextBlock Text="Fire" Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </DockPanel>
                            </Button>
                            <TextBlock Style="{StaticResource SxRailHead}" Text="MORE" Margin="10,14,0,6"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                            <Button Style="{StaticResource SxRailNav}"
                                    Command="{Binding SelectedBillPricingViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsBillPricingActive}"
                                    ToolTip="Price a client's bill with your rates">
                                <DockPanel>
                                    <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Excel}" />
                                    <TextBlock Text="Price a bill" Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource SxRailNav}"
                                    Command="{Binding SelectedCarbonOthersViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsCarbonOthersActive}"
                                    ToolTip="Carbon &amp; Others">
                                <DockPanel>
                                    <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Carbon}" />
                                    <TextBlock Text="Carbon &amp; Others" Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource SxRailNav}"
                                    Command="{Binding SelectedCustomRateInputViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsCustomRateInputActive}"
                                    ToolTip="Saved Rates">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                               FontSize="11" FontWeight="Bold" Opacity="0.8"
                                               Text="{Binding CustomRateListViewModel.CustomRates.Count, FallbackValue=''}"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                    <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Saved}" />
                                    <TextBlock Text="Saved Rates" Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </DockPanel>
                            </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!--────────  TOP BAR  ─────────-->
                <controls:Header x:Name="AppHeader"
                                 Grid.Row="0"
                                 Grid.Column="1" />

                <!--────────  WORK AREA  ─────────-->
                <Grid Grid.Row="1"
                      Grid.Column="1"
                      Background="{DynamicResource SxBgAlt}">
                    <Grid Margin="22,24,22,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <suite:SuiteBanner FirstName="{Binding CurrentUser.DisplayName, Converter={StaticResource FirstNameConv}, Mode=OneWay}"
                                           HideCommand="{Binding ToggleWelcomeBannerCommand}"
                                           Visibility="{Binding IsWelcomeBannerVisible, Converter={StaticResource BoolVis}}" />
                        <ContentControl Grid.Row="1"
                                        Content="{Binding SelectedViewModel}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" />
                    </Grid>
                </Grid>
            </Grid>
            <!-- Busy overlay (only one PopupHost in this window) -->
            <Grid Panel.ZIndex="150"
                  Background="{DynamicResource SxVeil}"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                <Border Width="420"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource SxSheet}">
                    <StackPanel>
                        <TextBlock Text="{Binding BusyMessage}"
                                   Style="{StaticResource SxH3}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16" />
                        <suiteView:SuiteProgress Steps="{Binding BusySteps}"
                                                 Step="{Binding BusyStep}" />
                    </StackPanel>
                </Border>
            </Grid>
            <view:PopupHost x:Name="PopupHost"
                            Visibility="Collapsed"
                            Panel.ZIndex="99" />

            <!--────────  SCREEN WATERMARK  ─────────
                 Deliberately NOT drawn on screen. The mark is applied to the
                 captured image instead — see Services/ScreenshotWatermark.cs —
                 so the app stays clean to work in and a screenshot still carries
                 its source. -->
    </Grid>
</Window>
