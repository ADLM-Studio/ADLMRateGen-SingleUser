<Window x:Class="ADLMRateGen.MainWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ADLMRateGen.ViewModel"
        xmlns:view="clr-namespace:ADLMRateGen.View"
        xmlns:controls="clr-namespace:ADLMCivilPlugin.Controls"
        xmlns:ground="clr-namespace:ADLMRateGen.ViewModel.Groundwork"
        xmlns:concrete="clr-namespace:ADLMRateGen.ViewModel.ConcreteWork"
        xmlns:blockwork="clr-namespace:ADLMRateGen.ViewModel.BlockWork"
        xmlns:mepwork="clr-namespace:ADLMRateGen.ViewModel.MepWork"
        xmlns:finishes="clr-namespace:ADLMRateGen.ViewModel.Finishes"
        xmlns:roof="clr-namespace:ADLMRateGen.ViewModel.RoofWork"
        xmlns:windowAndDoor="clr-namespace:ADLMRateGen.ViewModel.WindowAndDoor"
        xmlns:paint="clr-namespace:ADLMRateGen.ViewModel.Painting"
        xmlns:carbon="clr-namespace:ADLMRateGen.ViewModel.CarbonOthers"
        xmlns:steel="clr-namespace:ADLMRateGen.ViewModel.SteelWork"
        xmlns:customInput="clr-namespace:ADLMRateGen.ViewModel.CustomRate"
        xmlns:helpers="clr-namespace:ADLMRateGen.Helpers"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:conv="clr-namespace:ADLMRateGen.Converters"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        mc:Ignorable="d"
        Title="ADLM Rate Gen"
        WindowStyle="SingleBorderWindow"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MainBg}">
    <!-- ───────── RESOURCES ───────── -->
    <Window.Resources>
        <ResourceDictionary>
            <conv:FirstNameConverter x:Key="FirstNameConv" />
            <!-- ── VIEW  DATA-TEMPLATES  (unchanged) ── -->
            <DataTemplate DataType="{x:Type vm:SignInViewModel}">
                <view:SignInUserControl />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MaterialLibraryViewModel}">
                <view:MaterialLibraryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MaterialPriceViewModel}">
                <view:MaterialPriceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LabourLibraryViewModel}">
                <view:LabourLibraryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LabourPriceViewModel}">
                <view:LabourPriceView />
            </DataTemplate>
            <!-- discipline templates -->
            <DataTemplate DataType="{x:Type ground:GroundWorkViewModel}">
                <view:GroundWorkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type concrete:ConcreteViewModel}">
                <view:ConcreteWorkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type blockwork:BlockworkViewModel}">
                <view:BlockworkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type mepwork:MepWorkViewModel}">
                <view:MepWorkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type finishes:FinishesViewModel}">
                <view:FinishesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type roof:RoofWorkViewModel}">
                <view:RoofworkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type windowAndDoor:WindowAndDoorViewModel}">
                <view:WindowAndDoorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type paint:PaintWorkViewModel}">
                <view:PaintworkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type steel:SteelWorkViewModel}">
                <view:SteelworkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type carbon:CarbonOthersViewModel}">
                <view:CarbonOthersView />
            </DataTemplate>
            <!-- custom-rate -->
            <DataTemplate DataType="{x:Type customInput:CustomRateEntryViewModel}">
                <view:CustomRateEntryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type customInput:CustomRateListViewModel}">
                <view:CustomRateListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LibraryShellViewModel}">
                <view:LibraryShellView />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <!-- ───────── MAIN LAYOUT ───────── -->
    <Grid UseLayoutRounding="True"
          SnapsToDevicePixels="True">
            <!-- Sign-in overlay -->
            <ContentControl Content="{Binding SignInViewModel}"
                            Visibility="{Binding DataContext.IsLoggedIn,
                                                 ElementName=Root,
                                                 Converter={StaticResource InvBoolVis}}" />
            <!-- Logged-in shell -->
            <Grid x:Name="MainLayout"
                  Visibility="{Binding DataContext.IsLoggedIn,
                                       ElementName=Root,
                                       Converter={StaticResource BoolVis}}">
                <!-- ROWS  0-Header | 1-Body -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <!-- COLUMNS  0-Sidebar | 1-Splitter | 2-Main -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="250" MinWidth="62" MaxWidth="400" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--────────  SIDEBAR – spans ALL rows, collapsible  ────────-->
                <Border Grid.Row="0"
                        Grid.Column="0"
                        Grid.RowSpan="2"
                        Background="{DynamicResource BackgroundBrush}"
                        CornerRadius="0,0,20,0"
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0"
                                          Color="#000000" Opacity="0.10"
                                          Direction="0" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- ── Collapse / Expand toggle pinned at the top ── -->
                        <Button Grid.Row="0"
                                Command="{Binding ToggleSidebarCommand}"
                                ToolTip="Toggle sidebar (Ctrl+B)"
                                Cursor="Hand"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Width="38" Height="38"
                                Margin="0,10,6,0"
                                Background="{DynamicResource HoverLightBrush}"
                                BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ToggleBg"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="8"
                                            Padding="6">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ToggleBg"
                                                    Property="Background"
                                                    Value="{DynamicResource ActiveBgBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <fa:IconBlock Icon="AngleDoubleLeft"
                                              Width="18" Height="18"
                                              Foreground="{DynamicResource Blue900Brush}"
                                              Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolVis}}" />
                                <fa:IconBlock Icon="AngleDoubleRight"
                                              Width="18" Height="18"
                                              Foreground="{DynamicResource Blue900Brush}"
                                              Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolVis}}" />
                            </Grid>
                        </Button>

                        <!-- ── Scrollable sidebar content ── -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="4,4,4,12">
                        <!-- ── Full logo (hidden when collapsed) ── -->
                        <Image Source="/Resources/adlm_rate_generator_logo_small.png"
                               Width="90"
                               Margin="0,0,0,20"
                               HorizontalAlignment="Center"
                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolVis}}" />
                        <!-- ── Small icon logo (shown only when collapsed) ── -->
                        <Image Source="/Resources/adlmlogosml.jpg"
                               Width="36" Height="36"
                               Margin="0,0,0,12"
                               HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolVis}}" />
                        <!-- ── Library button ── -->
                        <Button Style="{DynamicResource NavPrimaryButton}"
                                Command="{Binding SelectedMaterialLibraryViewCommand}"
                                helpers:ButtonHelper.IsActive="{Binding IsMaterialLibraryActive}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip="Library (Ctrl+1)">
                            <StackPanel Orientation="Horizontal"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                <fa:IconBlock Icon="ThLarge"
                                              Width="16" Height="16"
                                              Foreground="{DynamicResource BackgroundBrush}" />
                                <TextBlock Text="Library"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource BackgroundBrush}"
                                           FontFamily="{DynamicResource PoppinsFont}"
                                           FontWeight="Medium"
                                           FontSize="12.8"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                            </StackPanel>
                        </Button>
                        <!-- Sync from Cloud moved to the header action group, where the
                             other app-wide actions live. Its status now rides on that
                             button's tooltip. -->
                        <!-- ── Section label (Figma: Mont SemiBold 16px, #091E39) ── -->
                        <TextBlock Text="Item of works"
                                   FontFamily="{DynamicResource AppFont}"
                                   Margin="4,22,0,3"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Blue900Brush}"
                                   Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolVis}}" />
                        <Rectangle Height="2"
                                   Margin="0,0,0,8"
                                   Fill="#D9D9D9" />
                        <!-- ── work-item buttons ── -->
                        <StackPanel>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding SelectedGroundworkViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsGroundworkActive}"
                                    ToolTip="Ground (Ctrl+2)" Margin="0,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:IconBlock Icon="Truck" Width="16" Height="16"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <TextBlock Text="Ground" Margin="8,0,0,0"
                                               Style="{DynamicResource BtnSidebarText}"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding SelectedConcreteWorkViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsConcreteViewActive}"
                                    ToolTip="Concrete (Ctrl+3)" Margin="0,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:IconBlock Icon="Mixer" Width="16" Height="16"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <TextBlock Text="Concrete" Margin="8,0,0,0"
                                               Style="{DynamicResource BtnSidebarText}"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding SelectedBlockworkViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsBlockworkActive}"
                                    ToolTip="Block Works (Ctrl+4)" Margin="0,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:IconBlock Icon="TrowelBricks" Width="16" Height="16"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <TextBlock Text="Block Works" Margin="8,0,0,0"
                                               Style="{DynamicResource BtnSidebarText}"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding SelectedFinishesViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsFinishesActive}"
                                    ToolTip="Finishes (Ctrl+5)" Margin="0,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:IconBlock Icon="SheetPlastic" Width="16" Height="16"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <TextBlock Text="Finishes" Margin="8,0,0,0"
                                               Style="{DynamicResource BtnSidebarText}"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding SelectedRoofworkViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsRoofworkActive}"
                                    ToolTip="Roofs (Ctrl+6)" Margin="0,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:IconBlock Icon="PeopleRoof" Width="16" Height="16"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <TextBlock Text="Roofs" Margin="8,0,0,0"
                                               Style="{DynamicResource BtnSidebarText}"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding SelectedPaintworkViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsPaintingActive}"
                                    ToolTip="Painting (Ctrl+7)" Margin="0,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:IconBlock Icon="PaintRoller" Width="16" Height="16"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <TextBlock Text="Painting" Margin="8,0,0,0"
                                               Style="{DynamicResource BtnSidebarText}"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding SelectedSteelworkViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsSteelworkActive}"
                                    ToolTip="Steel (Ctrl+8)" Margin="0,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:IconBlock Icon="DrumSteelpan" Width="16" Height="16"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <TextBlock Text="Steel" Margin="8,0,0,0"
                                               Style="{DynamicResource BtnSidebarText}"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding SelectedWindowAndDoorViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsWindowAndDoorActive}"
                                    ToolTip="Window and Door (Ctrl+9)" Margin="0,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:IconBlock Icon="DoorOpen" Width="16" Height="16"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <TextBlock Text="Window and Door" Margin="8,0,0,0"
                                               Style="{DynamicResource BtnSidebarText}"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding SelectedCustomRateInputViewCommand}"
                                    ToolTip="Saved Rates" Margin="0,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:IconBlock Icon="Save" Width="16" Height="16"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <TextBlock Text="Saved Rates" Margin="8,0,0,0"
                                               Style="{DynamicResource BtnSidebarText}"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding SelectedCarbonOthersViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsCarbonOthersActive}"
                                    ToolTip="Carbon &amp; Others" Margin="0,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:IconBlock Icon="Leaf" Width="16" Height="16"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <TextBlock Text="Carbon &amp; Others" Margin="8,0,0,0"
                                               Style="{DynamicResource BtnSidebarText}"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Rectangle Height="1"
                                   Margin="0,8,0,0"
                                   Fill="{DynamicResource divBrush}" />
                        <!-- ── Utility buttons ── -->
                        <StackPanel Margin="0,16">
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    ToolTip="To CM App" Margin="0,2"
                                    Click="ToCmApp_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:IconBlock Icon="FileCsv" Width="16" Height="16"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <TextBlock Text="To CM App" Margin="8,0,0,0"
                                               Style="{DynamicResource BtnSidebarText}"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding ExportAllRatesCommand}"
                                    ToolTip="Export (Ctrl+E)" Margin="0,2"
                                    Visibility="{Binding IsExportVisible, Converter={StaticResource BoolVis}, FallbackValue=Visible}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:IconBlock Icon="FileExcel" Width="16" Height="16"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <TextBlock Text="Export" Margin="8,0,0,0"
                                               Style="{DynamicResource BtnSidebarText}"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding HelpCommand}"
                                    ToolTip="Help" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:IconBlock Icon="HandsHelping" Width="16" Height="16"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <TextBlock Text="Help" Margin="8,0,0,0"
                                               Style="{DynamicResource BtnSidebarText}"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </StackPanel>
                            </Button>
                            <!-- Coloured, because it is the one item here that ends
                                 the session rather than navigating. It sits in a list
                                 of look-alike navigation rows and should not be
                                 reachable by a mis-click. -->
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding LogoutCommand}"
                                    ToolTip="Log out" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:IconBlock Icon="RightFromBracket" Width="16" Height="16"
                                                  Foreground="{DynamicResource DangerBrush}" />
                                    <TextBlock Text="Log out" Margin="8,0,0,0"
                                               Style="{DynamicResource BtnSidebarText}"
                                               Foreground="{DynamicResource DangerBrush}"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                                </StackPanel>
                            </Button>

                            <!-- Closes the sidebar the way the design does. -->
                            <Rectangle Height="2"
                                       Margin="4,18,4,4"
                                       RadiusX="1"
                                       RadiusY="1"
                                       Fill="{DynamicResource DataPrimaryBrush}"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, ElementName=Root, Converter={StaticResource InvBoolVis}}" />
                        </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </Border>
                <!--────────  GRID SPLITTER (drag handle)  ─────────-->
                <GridSplitter Grid.Column="1"
                              Grid.RowSpan="2"
                              Width="6"
                              Panel.ZIndex="10"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              Cursor="SizeWE"
                              ResizeBehavior="PreviousAndNext"
                              DragDelta="SidebarSplitter_DragDelta"
                              DragCompleted="SidebarSplitter_DragCompleted">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border x:Name="SplitBorder"
                                    Width="6"
                                    Background="#06000000"
                                    CornerRadius="2">
                                <Rectangle Width="2"
                                           RadiusX="1" RadiusY="1"
                                           Fill="{DynamicResource LighterGrayBrush}"
                                           VerticalAlignment="Stretch"
                                           HorizontalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SplitBorder"
                                            Property="Background"
                                            Value="{DynamicResource ActiveBgBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!--────────  HEADER  ─────────-->
                <controls:Header x:Name="AppHeader"
                                 Grid.Row="0"
                                 Grid.Column="2" />
                <!--────────  BODY  ─────────-->
                <Grid Grid.Row="1"
                      Grid.Column="2"
                      Margin="24,0,24,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Margin="12 0 12 10"
                            Height="250"
                            CornerRadius="18"
                            Visibility="{Binding IsWelcomeBannerVisible,
                                                 Converter={StaticResource BoolVis}}"
                            SnapsToDevicePixels="True">
                        <Border.Background>
                            <ImageBrush ImageSource="/Resources/Backdrop.png"
                                        Stretch="Fill" />
                        </Border.Background>
                        <Grid>
                            <Image Source="/Resources/hex_big.png"
                                   Width="220"
                                   HorizontalAlignment="Right"
                                   Margin="0 -100 5 0" />
                            <Image Source="/Resources/hex_big.png"
                                   Width="100"
                                   HorizontalAlignment="Right"
                                   Margin="0,125,250,0"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <RotateTransform Angle="-8" />
                                </Image.RenderTransform>
                            </Image>
                            <Grid Margin="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/Resources/adlm_badge.png"
                                       Width="52"
                                       Margin="0 90 28 0"
                                       VerticalAlignment="Top" />
                                <Grid Grid.Column="2"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Margin="0,12,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               FontFamily="{DynamicResource AppFont}"
                                               FontSize="11"
                                               Foreground="#C6D1E7"
                                               Text="{Binding Source={x:Static sys:DateTime.Now},
                                                              StringFormat='{}{0:dddd, d MMMM yyyy | h:mm tt}'}" />
                                    <TextBlock Grid.Row="1"
                                               FontFamily="{DynamicResource AppFont}"
                                               FontSize="28"
                                               Foreground="White"
                                               FontWeight="SemiBold">
                                        <Run Text="Welcome Back, " />
                                        <Run Text="{Binding CurrentUser.DisplayName, Converter={StaticResource FirstNameConv}, Mode=OneWay}"
                                             FontWeight="Bold" />
                                        <Run Text="!" /></TextBlock>
                                    <StackPanel Grid.Row="2"
                                                Orientation="Vertical"
                                                HorizontalAlignment="Left">
                                        <TextBlock Text="Extracting your quantities just got a lot easier. Try out our Revit and Planswift plugins today!"
                                                   MaxWidth="380"
                                                   FontFamily="{DynamicResource AppFont}"
                                                   FontSize="12"
                                                   Margin="0,10,0,0"
                                                   Foreground="#D8E0F4"
                                                   TextWrapping="Wrap" />
                                        <Button Style="{StaticResource invBtn}"
                                                Content="Try now  ➜"
                                                Command="{Binding OpenYoutubeCommand}"
                                                Margin="0,24,150,0" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1"
                            Margin="0,0,0,12"
                            Background="Transparent">
                        <ContentControl Content="{Binding SelectedViewModel}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" />
                    </Border>
                </Grid>
            </Grid>
            <!-- ✅ Global loader overlay (ONLY ONE PopupHost in this window) -->
            <Grid Panel.ZIndex="150"
                  Background="#80000000"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                <Border Width="420"
                        Padding="26"
                        CornerRadius="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource MainBg}"
                        Effect="{DynamicResource SoftShadow}">
                    <StackPanel>
                        <TextBlock Text="{Binding BusyMessage}"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Blue900Brush}"
                                   TextAlignment="Center"
                                   Margin="0,0,0,14" />
                        <ProgressBar Height="10"
                                     IsIndeterminate="True" />
                        <TextBlock Text="Please wait…"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="12"
                                   Opacity="0.8"
                                   Foreground="{DynamicResource Blue900Brush}"
                                   TextAlignment="Center"
                                   Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
            <!-- ✅ Keep ONLY ONE PopupHost with this name -->
            <view:PopupHost x:Name="PopupHost"
                            Visibility="Collapsed"
                            Panel.ZIndex="99" />

            <!--────────  SCREEN WATERMARK  ─────────
                 Deliberately NOT drawn on screen. The mark is applied to the
                 captured image instead — see Services/ScreenshotWatermark.cs —
                 so the app stays clean to work in and a screenshot still carries
                 its source. WatermarkBrush is kept in the themes for the day
                 someone wants the always-on version back; it covers a photograph
                 of the monitor, which the clipboard route cannot. -->
    </Grid>
</Window>
