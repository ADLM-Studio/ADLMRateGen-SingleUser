<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\ADLM Rate Generator Plugin.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- v2.6.2: The library merge no longer keys on the material/labour name.
         Keying threw on the first duplicate — and the shipped defaults carry
         500 rows for 477 names — so harvesting on save silently did nothing,
         and had it not thrown it would have written back one row per name. -->
    <!-- v2.6.1: AI-built rates kept their prices. A library reload — which every
         save triggers — was zeroing every AI line just before it was written to
         disk. Patch: fixes and UI feedback, no new behaviour. -->
    <!-- v2.6.0: API host resolved from configuration instead of a compiled-in
         constant, and repointed to the AWS backend. A stale value naming the
         retired Render host is ignored rather than obeyed, so machines whose
         installer wrote it into HKCU\Environment recover on upgrade. Custom
         rates also began feeding the price library on save. -->
    <!-- v2.5.0: Stable hardware device fingerprint (v2) shared with the other ADLM
         apps, replacing the MAC-based value that changed with the active network
         adapter and caused repeat DEVICE_MISMATCH sign-in failures. Minor rather
         than patch because device binding behaviour changes for every install. -->
    <!-- v2.7.0: First full price catalog refresh since launch (catalog 2026.08),
         calibrated against three priced 2026 bills with cement, rebar, sand and
         granite set from observed market prices. Adds a 67 row MEP section and an
         MEP rate engine. Fixes three costing defects: mixing labour charged at the
         day rate against an hourly quantity, fuel priced off the labourer rate at
         30 sites, and the tonne/m3 unit mismatch on aggregates. Minor rather than
         patch because every computed rate in the product changes. -->
    <Version>2.9.2</Version>
    <AssemblyVersion>2.9.2.0</AssemblyVersion>
    <FileVersion>2.9.2.0</FileVersion>
  </PropertyGroup>

  <!-- The test project lives under this project's directory, so the SDK's
