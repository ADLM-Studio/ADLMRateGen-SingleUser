<Window x:Class="ADLMRateGen.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ADLMRateGen.Controls"
        Title="ADLM RateGen"
        Width="895"
        Height="625"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <!-- Richard's splash (815 x 545 frame), with room round it for its shadow.
         The code-behind scales the window down on small screens; the card
         inside scales as one piece. -->
    <Grid Margin="40">
        <controls:SplashCard x:Name="Card">
            <controls:SplashCard.Effect>
                <DropShadowEffect BlurRadius="60" ShadowDepth="20" Direction="270" Opacity="0.6" Color="Black" />
            </controls:SplashCard.Effect>
        </controls:SplashCard>
    </Grid>
</Window>
