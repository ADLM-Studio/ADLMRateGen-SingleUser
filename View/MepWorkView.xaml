<UserControl x:Class="ADLMRateGen.View.MepWorkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:suite="clr-namespace:ADLMRateGen.View.Suite"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="640">
    <!-- Services: Mechanical, Electrical, Plumbing or Fire, whichever the rail
         opened. One engine, the shared trade screen, the discipline's own title. -->
    <suite:TradeScreen Title="{Binding DisciplineTitle}"
                       Items="{Binding MepWorkCollectionView}" />
</UserControl>
