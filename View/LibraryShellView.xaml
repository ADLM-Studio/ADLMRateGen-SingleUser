<UserControl x:Class="ADLMRateGen.View.LibraryShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- price notice, collapses to nothing when there is none -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--──────── HEAD (Richard's design, 30 Sep 2026) ─────────
             Title and what the library is, the Material | Labour switch drawn as
             the suite's segmented control, and the one add action, so the library
             reads like the trade screens it feeds. -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,24,0">
                <TextBlock Style="{StaticResource SxH1}" Text="Library" />
                <TextBlock Style="{StaticResource SxLede}" MaxWidth="720" HorizontalAlignment="Left"
                           Text="The material and labour prices every rate is built from. Fed from ADLM; your own prices stay on this PC." />
                <!-- Pricing location is set on the ADLM website, on your profile, and
                     arrives here on the next sign-in. The note says which zone the
                     prices come from, so the answer is on the screen. -->
                <DockPanel Margin="0,8,0,0">
                    <ContentControl Style="{StaticResource SxIcSm}" Tag="{StaticResource Ic.Profile}"
                                    Foreground="{DynamicResource SxInk3}" Margin="0,0,6,0" />
                    <TextBlock Style="{StaticResource SxMuted}" FontSize="12" Text="{Binding LocationNote}"
                               ToolTip="Set your pricing location on your ADLM profile on the website. It applies here on your next sign-in." />
                </DockPanel>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SxBtnAdd}" VerticalAlignment="Top"
                    Command="{Binding AddCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding AddButtonText}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Material | Labour -->
        <Border Grid.Row="1" HorizontalAlignment="Left" Margin="0,0,0,16" Padding="4"
                CornerRadius="12" BorderThickness="1"
                Background="{DynamicResource SxBgInset}" BorderBrush="{DynamicResource SxLine}">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SxSegment}"
                             IsChecked="{Binding IsMaterialTab, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource SxIcSm}" Tag="{StaticResource Ic.Block}" Margin="0,0,8,0" />
                        <TextBlock Text="Material" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SxSegment}"
                             IsChecked="{Binding IsLabourTab, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource SxIcSm}" Tag="{StaticResource Ic.Profile}" Margin="0,0,8,0" />
                        <TextBlock Text="Labour" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!--──────── YOUR PRICES vs NEWLY PUBLISHED ONES ─────────

             Shown only when the two disagree. Nothing has been lost by the time
             this appears: the figures the user typed are already the ones in use,
             and this is an offer to switch, not a warning.

             Per row, because "all or nothing" was the wrong question — someone may
             well want the new cement price and not the new diesel one. -->
        <Border Grid.Row="2"
                Margin="0,0,0,16"
                CornerRadius="18"
                Background="{DynamicResource SxBg}"
                BorderBrush="{DynamicResource SxAction}"
                BorderThickness="1"
                SnapsToDevicePixels="True"
                Visibility="{Binding IsPriceConflictPanelVisible, Converter={StaticResource BoolVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ── title bar ── -->
                <Grid Grid.Row="0"
                      Margin="16,14,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="30"
                            Height="30"
                            CornerRadius="10"
                            VerticalAlignment="Top"
                            Background="{DynamicResource SxBgAlt}">
                        <ContentControl Style="{StaticResource SxIcSm}" Tag="{StaticResource Ic.Refresh}" Foreground="{DynamicResource SxAction}" HorizontalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="12,0,12,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding PriceConflictSummary}"
                                   FontFamily="{StaticResource SxFont}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SxInk}" />
                        <TextBlock Text="{Binding PriceConflictDetail}"
                                   FontFamily="{StaticResource SxFont}"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   Opacity="0.75"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SxInk}" />
                    </StackPanel>

                    <!-- Hiding is not deciding: the review comes back from the bell. -->
                    <Button Grid.Column="2"
                            Command="{Binding HidePriceConflictsCommand}"
                            Style="{StaticResource SxSheetBtn}"
                            Width="28"
                            Height="28"
                            VerticalAlignment="Top"
                            ToolTip="Hide this for now. Reopen it from the notifications bell.">
                        <TextBlock Text="×" FontSize="16" Foreground="{DynamicResource SxInk2}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>

                <!-- ── column headings ── -->
                <!-- The scrollbar below steals width from the rows but not from this
                     bar, which left every heading sitting to the right of its own
                     column. Give the padding back only while the bar is actually up. -->
                <Border Grid.Row="1"
                        Background="{DynamicResource SxBgAlt}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Padding"
                                    Value="16,7" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, ElementName=ConflictScroller}"
                                             Value="Visible">
                                    <Setter Property="Padding"
                                            Value="16,7,33,7" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  IsThreeState="True"
                                  IsChecked="{Binding AllConflictsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  ToolTip="Select or clear every row" />

                        <TextBlock Grid.Column="1"
                                   Text="Item"
                                   FontFamily="{StaticResource SxFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SxInk3}" />
                        <TextBlock Grid.Column="2"
                                   Text="Unit"
                                   FontFamily="{StaticResource SxFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SxInk3}" />
                        <TextBlock Grid.Column="3"
                                   Text="Your price"
                                   FontFamily="{StaticResource SxFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource SxInk3}" />
                        <TextBlock Grid.Column="4"
                                   Text="Published"
                                   FontFamily="{StaticResource SxFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource SxInk3}" />
                        <TextBlock Grid.Column="5"
                                   Text="Change"
                                   FontFamily="{StaticResource SxFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource SxInk3}" />
                    </Grid>
                </Border>

                <!-- ── the rows ── -->
                <ScrollViewer Grid.Row="2"
                              x:Name="ConflictScroller"
                              MaxHeight="196"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding PriceConflictRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,8"
                                        BorderBrush="{DynamicResource SxLine}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontFamily="{StaticResource SxFont}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource SxInk}" />
                                            <TextBlock Text="{Binding Kind}"
                                                       FontFamily="{StaticResource SxFont}"
                                                       FontSize="10"
                                                       Opacity="0.6"
                                                       Foreground="{DynamicResource SxInk}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Unit}"
                                                   FontFamily="{StaticResource SxFont}"
                                                   FontSize="11.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SxInk}" />

                                        <!-- Yours is in force today, so it reads as the firm value. -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding YourPrice, Converter={StaticResource MoneyConv}, StringFormat=N0}"
                                                   FontFamily="{StaticResource SxFont}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource SxInk}" />

                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding PublishedPrice, Converter={StaticResource MoneyConv}, StringFormat=N0}"
                                                   FontFamily="{StaticResource SxFont}"
                                                   FontSize="11.5"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Opacity="0.85"
                                                   Foreground="{DynamicResource SxInk}" />

                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding ChangeText}"
                                                   FontFamily="{StaticResource SxFont}"
                                                   FontSize="11.5"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource SxInk}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsIncrease}"
                                                                     Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource PriceUpBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsIncrease}"
                                                                     Value="False">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource PriceDownBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- ── actions ── -->
                <Grid Grid.Row="3"
                      Margin="16,12,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding SelectionSummary}"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource SxFont}"
                               FontSize="11.5"
                               Opacity="0.75"
                               Foreground="{DynamicResource SxInk}" />

                    <Button Grid.Column="1"
                            Command="{Binding KeepMyPricesCommand}"
                            IsEnabled="{Binding HasSelectedConflicts}"
                            Style="{StaticResource SxBtnGhostSm}"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            ToolTip="Keep your own figures on the ticked rows, and stop asking about them.">
                        <TextBlock Text="Keep mine" />
                    </Button>

                    <Button Grid.Column="2"
                            Command="{Binding UseServerPricesCommand}"
                            IsEnabled="{Binding HasSelectedConflicts}"
                            Style="{StaticResource SxBtnSm}"
                            VerticalAlignment="Center"
                            ToolTip="Take the published price on the ticked rows. Archived first, so it can be undone.">
                        <TextBlock Text="Use published" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!--──────── BODY (fills remaining space) ─────────-->
        <ContentControl Grid.Row="3"
                        Content="{Binding CurrentContent}" />

    </Grid>



</UserControl>
