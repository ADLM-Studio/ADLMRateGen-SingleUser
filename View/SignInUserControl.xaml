<UserControl x:Class="ADLMRateGen.View.SignInUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:controls="clr-namespace:ADLMRateGen.Controls"
             mc:Ignorable="d"
             d:DesignWidth="895"
             d:DesignHeight="625">
    <!-- Sign-in IS the splash (Richard's design, 30 Sep 2026): the same card,
         with the lockup, wordmark, version, artwork and footer where they were,
         and only the middle of the plate changing to the form. Sizes below are
         design pixels on the 815 x 545 frame; the card scales them as one. -->
    <UserControl.Resources>
        <Style x:Key="SpLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SxFont}" />
            <Setter Property="FontSize" Value="8.6" />
            <Setter Property="Foreground" Value="#B8FFFFFF" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SpInput" TargetType="Control">
            <Setter Property="FontFamily" Value="{StaticResource SxFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#0B1C30" />
            <Setter Property="Background" Value="#F2EEF4FA" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SpTextBox" TargetType="TextBox" BasedOn="{StaticResource SpInput}">
            <Setter Property="CaretBrush" Value="#0B1C30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FB0FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SpPassword" TargetType="PasswordBox" BasedOn="{StaticResource SpInput}">
            <Setter Property="Padding" Value="11,8,30,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FB0FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SpLink" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource SxFont}" />
            <Setter Property="FontSize" Value="8.6" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#7FCBFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="T" Text="{TemplateBinding Content}" Background="Transparent" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="T" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SpButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource SxFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Content" Value="Log in" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Padding="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#3FADFF" Offset="0" />
                                    <GradientStop Color="#1289E6" Offset="0.52" />
                                    <GradientStop Color="#0768B6" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Content" Value="Signing in…" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot">
        <!-- The card, with its splash middle cleared for the form -->
        <controls:SplashCard x:Name="Card" MaxWidth="815" MaxHeight="545">
            <controls:SplashCard.Form>
                <Border />
            </controls:SplashCard.Form>
        </controls:SplashCard>

        <!-- The form, in its own layer at the same design pixels (46, 205, 241 wide):
             the fields are named for the code-behind, which a control's content
             cannot be. Same Viewbox and frame, so it lands exactly on the plate. -->
        <Viewbox x:Name="FormLayer" Stretch="Uniform" MaxWidth="815" MaxHeight="545">
            <Canvas Width="815" Height="545">
                <StackPanel Canvas.Left="46" Canvas.Top="205" Width="241">
                    <TextBlock Style="{StaticResource SpLabel}" Text="Email or username" />
                    <TextBox x:Name="EmailTextBox" Style="{StaticResource SpTextBox}" Margin="0,0,0,10"
                             KeyDown="LoginField_KeyDown"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource SpLabel}" Text="Password" />
                    <Grid Margin="0,0,0,10">
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource SpPassword}"
                                     KeyDown="LoginField_KeyDown"
                                     PasswordChanged="PasswordBox_PasswordChanged" />
                        <TextBox x:Name="PasswordPreviewTextBox" Style="{StaticResource SpTextBox}" Padding="11,8,30,8"
                                 Visibility="Collapsed"
                                 KeyDown="LoginField_KeyDown"
                                 TextChanged="PasswordPreviewTextBox_TextChanged" />
                        <Button Width="24" Height="24" HorizontalAlignment="Right" Margin="0,0,4,0"
                                VerticalAlignment="Center" Focusable="False" Cursor="Hand"
                                ToolTip="Show or hide the password" Click="TogglePwd_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="B" Background="Transparent" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="B" Property="Background" Value="#1A0B1C30" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <fa:IconBlock x:Name="PasswordToggleIcon" Icon="Eye" Width="12" Height="12"
                                          Foreground="#5B6D80" />
                        </Button>
                    </Grid>

                    <Button Style="{StaticResource SpButton}" Margin="0,4,0,0" Command="{Binding LoginCommand}" />

                    <DockPanel Margin="0,9,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SpLink}" Content="Create account"
                                Click="OpenSignUp_Click" />
                        <Button Style="{StaticResource SpLink}" Content="Forgot password?" HorizontalAlignment="Left"
                                Click="OpenForgotPassword_Click" />
                    </DockPanel>
                </StackPanel>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
