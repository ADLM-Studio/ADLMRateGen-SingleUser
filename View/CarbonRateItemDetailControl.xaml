<UserControl x:Class="ADLMRateGen.View.CarbonRateItemDetailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Tag="SxSheet"
             d:DesignHeight="640" d:DesignWidth="820">
    <!-- Rate Composition (Richard's design, 30 Sep 2026): opening a rate shows
         what it is made of. One layout for every trade; this file differs from
         its siblings only in the class and the breakdown it lists. -->
    <Border Style="{StaticResource SxSheet}" MinWidth="560" MaxWidth="980" MaxHeight="760">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Head: back, title, close -->
            <DockPanel Margin="24,24,24,16">
                <Button DockPanel.Dock="Left" Style="{StaticResource SxSheetBtn}" Content="‹"
                        Click="BackButton_Click" ToolTip="Back to the table" Margin="0,0,10,0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource SxSheetBtn}" Content="×"
                        Click="BackButton_Click" ToolTip="Close" />
                <TextBlock Style="{StaticResource SxH2}" Text="Rate Composition" VerticalAlignment="Center" />
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="24,0,24,24">
                <StackPanel>
                    <TextBlock Style="{StaticResource SxText}" FontSize="15" FontWeight="SemiBold" LineHeight="23"
                               TextWrapping="Wrap" Margin="0,0,0,16" Text="{Binding Description}" />

                    <Border BorderBrush="{DynamicResource SxLine2}" BorderThickness="0,0,0,1" Padding="10,0,10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SxCellMuted}" FontSize="11" FontWeight="SemiBold" Text="COMPONENT" />
                            <TextBlock Grid.Column="1" Style="{StaticResource SxCellMuted}" FontSize="11" FontWeight="SemiBold" Text="QUANTITY" TextAlignment="Right" Padding="0,0,11,0" />
                            <TextBlock Grid.Column="2" Style="{StaticResource SxCellMuted}" FontSize="11" FontWeight="SemiBold" Text="UNIT" Padding="12,0,0,0" />
                            <TextBlock Grid.Column="3" Style="{StaticResource SxCellMuted}" FontSize="11" FontWeight="SemiBold" Text="UNIT PRICE" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Style="{StaticResource SxCellMuted}" FontSize="11" FontWeight="SemiBold" Text="AMOUNT" TextAlignment="Right" />
                            <TextBlock Grid.Column="5" Style="{StaticResource SxCellMuted}" FontSize="11" FontWeight="SemiBold" Text="KGCO2E" TextAlignment="Right" />
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding BreakdownLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource SxLine}" BorderThickness="0,0,0,1" Padding="10,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTotalLine}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SxBgAlt}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <!-- A component that is a library item opens the library at
                                             its row; totals and percentages do not look clickable. -->
                                        <TextBlock Text="{Binding ComponentName}" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding OpenInLibraryCommand}"
                                                              CommandParameter="{Binding ComponentName}" />
                                            </TextBlock.InputBindings>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SxCell}">
                                                    <Setter Property="FontSize" Value="13.5" />
                                                    <Setter Property="FontWeight" Value="Medium" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanOpenInLibrary}" Value="True">
                                                            <Setter Property="Cursor" Value="Hand" />
                                                            <Setter Property="ToolTip" Value="Open this in the library" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsTotalLine}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                <TextBlock Grid.Column="1" Padding="0,0,11,0" VerticalAlignment="Center"
                                           Style="{StaticResource SxCellNum}"
                                           Text="{Binding Quantity, StringFormat={}{0:0.####}}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource SxCellMuted}" Padding="12,0,0,0"
                                                   VerticalAlignment="Center" Text="{Binding Unit}" />
                                        <!-- A sum or a percentage has no unit price; show nothing rather than 0.00 -->
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                                   Text="{Binding UnitPrice, Converter={StaticResource MoneyConv}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SxCellNum}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UnitPrice}" Value="0">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                                   Text="{Binding TotalPrice, Converter={StaticResource MoneyConv}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SxCellNum}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TotalPrice}" Value="0">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- the line's carbon; hover for how it was worked out and where the factor comes from -->
                                        <TextBlock Grid.Column="5" Style="{StaticResource SxCellNumB}" VerticalAlignment="Center"
                                                   Text="{Binding CarbonKg, StringFormat={}{0:N3}, TargetNullValue='-'}"
                                                   ToolTip="{Binding CarbonBasis}" ToolTipService.ShowDuration="60000" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

                <Border Grid.Row="2" Style="{StaticResource SxSheetFoot}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SxBtn}" Content="Close"
                                Click="BackButton_Click" />
                        <TextBlock Style="{StaticResource SxMuted}" VerticalAlignment="Center" Margin="0,0,16,0"
                                   Text="Carbon from this rate's own build-up: change a quantity in its trade and the carbon follows. Hover a figure for its factor and source. Labour and plant hire carry no material carbon; site fuel is A5a." />
                    </DockPanel>
                </Border>
        </Grid>
    </Border>
</UserControl>
