<Window x:Class="ADLMRateGen.View.Suite.SuiteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Title="ADLM RateGen">
    <!-- ADLM.dialog / ADLM.confirm in the desktop app (Richard's rule 4: the
         customer never sees the engine's own chrome). It covers its owner with
         the suite veil and puts one sheet in the middle: title, words, optional
         label/value rows, a secondary and a primary button. -->
    <Grid Background="{DynamicResource SxVeil}">
        <Border Style="{StaticResource SxSheet}" Width="460" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="24,24,24,20">
                    <DockPanel Margin="0,0,0,8">
                        <Border x:Name="Mark" Width="32" Height="32" CornerRadius="9" Margin="0,0,12,0"
                                Background="{DynamicResource SxBgInset}" VerticalAlignment="Top">
                            <ContentControl x:Name="MarkIcon" Style="{StaticResource SxIc}" HorizontalAlignment="Center"
                                            Tag="{StaticResource Ic.Help}" Foreground="{DynamicResource SxAction}" />
                        </Border>
                        <TextBlock x:Name="Head" Style="{StaticResource SxH3}" FontSize="17" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="Body" Style="{StaticResource SxLede}" FontSize="13.5" LineHeight="21"
                               Margin="44,0,0,0" />
                    <ItemsControl x:Name="Rows" Margin="44,14,0,0" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource SxLine}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource SxCellNumB}" Text="{Binding Value}" />
                                        <TextBlock Style="{StaticResource SxCellUnit}" Text="{Binding Label}" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource SxSheetFoot}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="No" Style="{StaticResource SxBtnGhost}" Margin="0,0,10,0" IsCancel="True"
                                Click="No_Click" />
                        <Button x:Name="Yes" Style="{StaticResource SxBtn}" IsDefault="True" Click="Yes_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
