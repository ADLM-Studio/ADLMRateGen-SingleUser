<UserControl x:Class="ADLMRateGen.View.CustomRateEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:suite="clr-namespace:ADLMRateGen.View.Suite"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1080">
    <!-- Build New Custom Rate (Richard's design, 30 Sep 2026; builder() in
         rategen-app.js). Name it, set overhead and profit, then list what goes
         into it - from scratch, or drafted by ADLM AI from a sentence. Custom
         rates are created here and only here, and stay on this PC. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource SxText}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource SxInk3}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <!-- The name picker: an editable field in the suite's outline, with the
             library's own items underneath it -->
        <Style x:Key="PickCombo" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource SxFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource SxInk}" />
            <Setter Property="Background" Value="{DynamicResource SxBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SxLine2}" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="9" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.ColumnSpan="2" Focusable="False" ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Background="Transparent">
                                                    <Path Data="M0,0 L4.5,4.5 L9,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                          Margin="0,0,11,0" Stroke="{DynamicResource SxInk3}" StrokeThickness="1.6"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Grid>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <TextBox x:Name="PART_EditableTextBox" Background="Transparent" BorderThickness="0"
                                             IsReadOnly="{TemplateBinding IsReadOnly}"
                                             Foreground="{TemplateBinding Foreground}" CaretBrush="{DynamicResource SxInk}"
                                             FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                             Padding="{TemplateBinding Padding}" VerticalContentAlignment="Center" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" VerticalOffset="4">
                                <Border Background="{DynamicResource SxBg}" BorderBrush="{DynamicResource SxLine2}"
                                        BorderThickness="1" CornerRadius="10" Padding="4"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.18" />
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SxInk3}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SxAction}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource SxSheet}" MaxWidth="1080">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Head -->
            <DockPanel Margin="24,24,24,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource SxSheetBtn}" Content="×" VerticalAlignment="Top"
                        Click="Close_Click" ToolTip="Close without saving" />
                <StackPanel>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SxH2}">
                                <Setter Property="Text" Value="Build New Custom Rate" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Text" Value="Edit Custom Rate" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource SxLede}" Foreground="{DynamicResource SxInk3}"
                               Text="Name it, set overhead and profit, then list what goes into it." />
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly" Padding="24,0,24,24">
                <StackPanel>

                    <!-- Build with AI (the ADLM AI add-on; hidden only when switched off) -->
                    <Border Visibility="{Binding IsAiAvailable, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource SxBgAlt}" BorderBrush="{DynamicResource SxLine2}"
                            BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SxLabel}" Text="Build with AI" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Shows the phrasing the guard needs, before a request is refused -->
                                <TextBox Style="{StaticResource SxField}"
                                         Tag="e.g. Build a rate for 225mm blockwork in cement mortar (1:6)"
                                         Text="{Binding AiPrompt, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsAiIdle}" />
                                <Button Grid.Column="1" Style="{StaticResource SxBtn}" Margin="10,0,0,0"
                                        Command="{Binding BuildWithAiCommand}" IsEnabled="{Binding IsAiIdle}">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Style="{StaticResource SxIcSm}" Tag="{StaticResource Ic.Spark}" Margin="0,0,8,0" />
                                        <TextBlock Text="Build with AI" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Named steps while it works: the one place a build takes time -->
                            <suite:SuiteProgress Margin="0,16,0,0" Steps="{Binding AiSteps}" Step="{Binding AiStep}"
                                                 Visibility="{Binding IsAiBusy, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Style="{StaticResource SxMuted}" FontSize="11.5" LineHeight="18" Margin="0,10,0,0"
                                       Text="{Binding AiStatus}" />
                            <TextBlock Style="{StaticResource SxMuted}" FontSize="11.5" LineHeight="18" Margin="0,6,0,0"
                                       Text="An AI draft is an advisory estimate from the ADLM library and market data. It is not a professional opinion and not for contract use until you have checked every line." />

                            <!-- ADLM's checks failed: loud on purpose. A rate that is wrong but
                                 plausible gets used in a tender; an obviously broken one does not. -->
                            <Border Visibility="{Binding HasAiWarnings, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource SxAccentTint}" BorderBrush="{DynamicResource SxAccent}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SxText}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SxAccent}" TextWrapping="Wrap"
                                               Text="This build-up did not pass ADLM's checks" />
                                    <ItemsControl ItemsSource="{Binding AiWarnings}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,3,0,0">
                                                    <TextBlock Text="•" Margin="0,0,6,0" Foreground="{DynamicResource SxAccent}" />
                                                    <TextBlock Style="{StaticResource SxText}" FontSize="12" TextWrapping="Wrap" Text="{Binding}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource SxMuted}" FontSize="11.5" Margin="0,8,0,0"
                                               Text="Correct the flagged lines before saving: the quantities, not just the prices." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SxLabel}" Text="Name of rate" />
                    <TextBox Style="{StaticResource SxField}" Margin="0,0,0,16"
                             Text="{Binding RateName, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SxLabel}" Text="Overhead" />
                            <Border Style="{StaticResource SxBox}" Padding="16,11">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource SxMuted}" Text="%" VerticalAlignment="Center" />
                                    <TextBox Style="{StaticResource SxBare}" FontSize="13.5"
                                             ToolTip="Overhead as a percentage of the material and labour total"
                                             Text="{Binding OverheadPercentText, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </Border>
                            <TextBlock Style="{StaticResource SxMuted}" FontSize="11.5" Margin="0,4,0,0"
                                       Text="{Binding OverheadAmount, StringFormat='= {0:N2}'}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource SxLabel}" Text="Profit" />
                            <Border Style="{StaticResource SxBox}" Padding="16,11">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource SxMuted}" Text="%" VerticalAlignment="Center" />
                                    <TextBox Style="{StaticResource SxBare}" FontSize="13.5"
                                             ToolTip="Profit as a percentage of the material and labour total"
                                             Text="{Binding ProfitPercentText, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </Border>
                            <TextBlock Style="{StaticResource SxMuted}" FontSize="11.5" Margin="0,4,0,0"
                                       Text="{Binding ProfitAmount, StringFormat='= {0:N2}'}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource SxLabel}" Text="Description — the wording that goes on the bill" />
                    <TextBox Style="{StaticResource SxField}" TextWrapping="Wrap" AcceptsReturn="True"
                             MinHeight="84" VerticalContentAlignment="Top"
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Materials -->
                    <Border BorderBrush="{DynamicResource SxLine}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,16,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SxBtnGhostSm}" Content="Add material"
                                        Command="{Binding AddMaterialItemCommand}" />
                                <TextBlock Style="{StaticResource SxH3}" VerticalAlignment="Center">
                                    <Run Text="Materials" /><Run Text="   Everything that is bought" FontSize="12" FontWeight="Normal"
                                         Foreground="{DynamicResource SxInk3}" />
                                </TextBlock>
                            </DockPanel>
                        <ItemsControl ItemsSource="{Binding MaterialItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="160" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Name of material" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource RowLabel}" Text="Rate" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource RowLabel}" Text="Unit" />
                                        <TextBlock Grid.Column="6" Style="{StaticResource RowLabel}" Text="Quantity" />
                                        <TextBlock Grid.Column="8" Style="{StaticResource RowLabel}" Text="Amount" />

                                        <!-- Type, or pick from the library so its price applies -->
                                        <ComboBox Grid.Row="1"
                                                  IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                                  Text="{Binding Description, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  ItemsSource="{Binding DataContext.AvailableMaterials, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  Style="{StaticResource PickCombo}"
                                                  ItemContainerStyle="{StaticResource SxSelectItem}" />
                                        <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource SxFieldNum}"
                                                 Text="{Binding UnitPrice, StringFormat=N0, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" />
                                        <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource SxFieldSm}"
                                                 Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                        <TextBox Grid.Row="1" Grid.Column="6" Style="{StaticResource SxFieldNum}"
                                                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                        <TextBox Grid.Row="1" Grid.Column="8" Style="{StaticResource SxFieldNum}" IsReadOnly="True"
                                                 Focusable="False"
                                                 Text="{Binding TotalCost, StringFormat=N0, Mode=OneWay}" />
                                        <Button Grid.Row="1" Grid.Column="9" Style="{StaticResource SxDel}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                ToolTip="Remove this line" AutomationProperties.Name="Remove"
                                                Click="RemoveRow_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No materials yet.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SxNone}">
                                    <Setter Property="Margin" Value="0,6,0,10" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MaterialItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Labour -->
                    <Border BorderBrush="{DynamicResource SxLine}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SxBtnGhostSm}" Content="Add labour"
                                        Command="{Binding AddLabourItemCommand}" />
                                <TextBlock Style="{StaticResource SxH3}" VerticalAlignment="Center">
                                    <Run Text="Labour" /><Run Text="   Everything that is worked" FontSize="12" FontWeight="Normal"
                                         Foreground="{DynamicResource SxInk3}" />
                                </TextBlock>
                            </DockPanel>
                        <ItemsControl ItemsSource="{Binding LabourItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="160" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Name of labour" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource RowLabel}" Text="Rate" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource RowLabel}" Text="Unit" />
                                        <TextBlock Grid.Column="6" Style="{StaticResource RowLabel}" Text="Quantity" />
                                        <TextBlock Grid.Column="8" Style="{StaticResource RowLabel}" Text="Amount" />

                                        <!-- Type, or pick from the library so its price applies -->
                                        <ComboBox Grid.Row="1"
                                                  IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                                  Text="{Binding Description, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  ItemsSource="{Binding DataContext.AvailableLabourItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  Style="{StaticResource PickCombo}"
                                                  ItemContainerStyle="{StaticResource SxSelectItem}" />
                                        <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource SxFieldNum}"
                                                 Text="{Binding UnitPrice, StringFormat=N0, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" />
                                        <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource SxFieldSm}"
                                                 Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                        <TextBox Grid.Row="1" Grid.Column="6" Style="{StaticResource SxFieldNum}"
                                                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                        <TextBox Grid.Row="1" Grid.Column="8" Style="{StaticResource SxFieldNum}" IsReadOnly="True"
                                                 Focusable="False"
                                                 Text="{Binding TotalCost, StringFormat=N0, Mode=OneWay}" />
                                        <Button Grid.Row="1" Grid.Column="9" Style="{StaticResource SxDel}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                ToolTip="Remove this line" AutomationProperties.Name="Remove"
                                                Click="RemoveRow_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No labour yet.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SxNone}">
                                    <Setter Property="Margin" Value="0,6,0,10" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LabourItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Summary -->
                    <Border BorderBrush="{DynamicResource SxLine}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
                        <UniformGrid x:Name="Summary" Columns="3" Margin="0,0,-10,0">
                            <Border Background="{DynamicResource SxBgAlt}" CornerRadius="10" Padding="12,10" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SxMuted}" FontSize="11" Text="Material total" />
                                    <TextBlock Style="{StaticResource SxCellNumB}" FontSize="15" TextAlignment="Left" Margin="0,2,0,0"
                                               Text="{Binding TotalMaterialCost, Mode=OneWay, StringFormat=N2}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SxBgAlt}" CornerRadius="10" Padding="12,10" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SxMuted}" FontSize="11" Text="Labour total" />
                                    <TextBlock Style="{StaticResource SxCellNumB}" FontSize="15" TextAlignment="Left" Margin="0,2,0,0"
                                               Text="{Binding TotalLabourCost, Mode=OneWay, StringFormat=N2}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SxBgAlt}" CornerRadius="10" Padding="12,10" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SxMuted}" FontSize="11" Text="Overall" />
                                    <TextBlock Style="{StaticResource SxCellNumB}" FontSize="15" TextAlignment="Left" Margin="0,2,0,0"
                                               Text="{Binding OverallTotal, Mode=OneWay, StringFormat=N2}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SxBgAlt}" CornerRadius="10" Padding="12,10" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SxMuted}" FontSize="11"><Run Text="Overhead (" /><Run Text="{Binding OverheadPercent, Mode=OneWay, StringFormat=0.##}" /><Run Text="%)" /></TextBlock>
                                    <TextBlock Style="{StaticResource SxCellNumB}" FontSize="15" TextAlignment="Left" Margin="0,2,0,0"
                                               Text="{Binding OverheadAmount, Mode=OneWay, StringFormat=N2}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SxBgAlt}" CornerRadius="10" Padding="12,10" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SxMuted}" FontSize="11"><Run Text="Profit (" /><Run Text="{Binding ProfitPercent, Mode=OneWay, StringFormat=0.##}" /><Run Text="%)" /></TextBlock>
                                    <TextBlock Style="{StaticResource SxCellNumB}" FontSize="15" TextAlignment="Left" Margin="0,2,0,0"
                                               Text="{Binding ProfitAmount, Mode=OneWay, StringFormat=N2}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Border>
                    <Border Background="{DynamicResource SxBgInset}" CornerRadius="10" Padding="14,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SxMuted}" FontSize="11" Text="Grand total" />
                            <TextBlock Style="{StaticResource SxCellNumB}" FontSize="20" TextAlignment="Left" Margin="0,2,0,0"
                                       Text="{Binding GrandTotal, Mode=OneWay, StringFormat=N2}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Style="{StaticResource SxSheetFoot}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource SxBtnGhost}" Content="Cancel" Margin="0,0,10,0" Click="Close_Click" />
                    <Button Grid.Column="1" Command="{Binding SaveCustomRateCommand}"
                            ToolTip="Saved on this PC, in Saved Rates. Never sent into the ADLM library.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SxBtn}">
                                <Setter Property="Content" Value="Save this rate" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Content" Value="Update this rate" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
