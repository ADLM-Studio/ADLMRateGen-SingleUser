<UserControl x:Class="ADLMRateGen.View.LabourLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">
    <!-- The labour library on the suite's card, bar and table (Richard's design,
         30 Sep 2026): the same find / filter / sort bar and the same table as the
         trade screens, so the library and the rates built from it read as one
         product. Click a row, or press Enter, to edit it; right-click or Delete
         for the rest. -->
    <Border Style="{StaticResource SxPanel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Bar: find, category, sort, then the one library-wide action -->
            <Grid x:Name="Bar" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="FindBox" Style="{StaticResource SxBox}" Margin="0,0,10,0">
                    <DockPanel>
                        <ContentControl Style="{StaticResource SxIcSm}" Tag="{StaticResource Ic.Search}"
                                        Foreground="{DynamicResource SxInk3}" Margin="0,0,8,0" />
                        <TextBox Style="{StaticResource SxBare}" Tag="Search the labour library"
                                 Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </Border>
                <ComboBox x:Name="CategoryBox" Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource SxSelect}" MinWidth="150" MaxWidth="260"
                          Margin="0,0,10,0" ToolTip="Show one category"
                          ItemsSource="{Binding LabourCategory}"
                          SelectedItem="{Binding SelectedLabourCategory, Mode=TwoWay}" />
                <ComboBox x:Name="SortBox" Grid.Column="2" Style="{StaticResource SxSelect}" Margin="0,0,10,0"
                          SelectedIndex="0" SelectionChanged="SortBox_SelectionChanged" ToolTip="Order the table">
                    <ComboBoxItem Content="Sort by · library order" />
                    <ComboBoxItem Content="Sort by · most expensive" />
                    <ComboBoxItem Content="Sort by · A to Z" />
                </ComboBox>
                <Button x:Name="UpdateButton" Grid.Column="3" Style="{StaticResource SxBtnGhost}"
                        Command="{Binding UpdatePricesCommand}"
                        ToolTip="Bring this library's prices up to date from ADLM. Your own prices are offered, not overwritten.">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource SxIcSm}" Tag="{StaticResource Ic.Refresh}" Margin="0,0,8,0" />
                        <TextBlock Text="Update prices" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <DataGrid x:Name="LabourGrid" MinWidth="760" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Style="{StaticResource SxTable}"
                          ItemsSource="{Binding LabourCollectionView}"
                          Tag="{Binding}"
                          PreviewMouseLeftButtonUp="Grid_PreviewMouseLeftButtonUp"
                          PreviewKeyDown="Grid_PreviewKeyDown">
                    <DataGrid.InputBindings>
                        <KeyBinding Key="Delete"
                                    Command="{Binding DataContext.DeleteLabourCommand, ElementName=LabourGrid}"
                                    CommandParameter="{Binding SelectedItem, ElementName=LabourGrid}" />
                    </DataGrid.InputBindings>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource SxTableRow}">
                            <!-- the view model rides on the row, for the context menu -->
                            <Setter Property="Tag"
                                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Edit"
                                                  Command="{Binding PlacementTarget.Tag.EditLabourCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="Delete"
                                                  Command="{Binding PlacementTarget.Tag.DeleteLabourCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="S/N" Binding="{Binding SerialNumber}" Width="56"
                                            ElementStyle="{StaticResource SxCellMuted}" />
                        <DataGridTemplateColumn Header="LABOUR NAME" SortMemberPath="LabourName" Width="2*" MinWidth="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource SxCellDesc}" Text="{Binding LabourName}"
                                               ToolTip="{Binding LabourName}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="UNIT" Binding="{Binding LabourUnit}" Width="80"
                                            ElementStyle="{StaticResource SxCellUnit}" />
                        <DataGridTextColumn Header="PRICE" Width="Auto" MinWidth="130"
                                            HeaderStyle="{StaticResource SxTableHeaderRight}"
                                            Binding="{Binding LabourPrice, Converter={StaticResource MoneyConv}, Mode=OneWay}"
                                            ElementStyle="{StaticResource SxCellNumB}" />
                        <DataGridTemplateColumn Header="CATEGORY" Width="*" MinWidth="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource SxCellUnit}" Margin="16,0,0,0"
                                               TextTrimming="CharacterEllipsis" Text="{Binding LabourCategory}"
                                               ToolTip="{Binding LabourCategory}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>

            <!-- Empty is a state -->
            <TextBlock x:Name="None" Grid.Row="1" Style="{StaticResource SxNone}" VerticalAlignment="Top"
                       Margin="0,56,0,0" Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
