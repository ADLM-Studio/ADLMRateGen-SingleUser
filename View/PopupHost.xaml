<UserControl x:Class="ADLMRateGen.View.PopupHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ADLMRateGen.Converters"
             Visibility="Collapsed">


    <UserControl.Resources>
        <conv:PercentConverter x:Key="PercentConverter" />
    </UserControl.Resources>

    <Grid>
        <!-- dim background -->
        <Rectangle Fill="{DynamicResource SxVeil}"
                   MouseDown="OnBackgroundClicked" />

        <!-- popup card — transparent wrapper, child views provide their own styling -->
        <Border x:Name="Card"
                MouseDown="OnCardMouseDown"
                MaxWidth="{Binding ActualWidth,
                           RelativeSource={RelativeSource AncestorType=UserControl},
                           Converter={StaticResource PercentConverter},
                           ConverterParameter=0.85}"
                MaxHeight="{Binding ActualHeight,
                            RelativeSource={RelativeSource AncestorType=UserControl},
                            Converter={StaticResource PercentConverter},
                            ConverterParameter=0.9}"
                Background="Transparent"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <Grid>
                    <!-- close button floats on top-right -->
                    <Button x:Name="HostClose"
                            Content="&#x2715;"
                            Width="36"
                            Height="36"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#5F6D7E"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-8,-8,0"
                            Cursor="Hand"
                            Panel.ZIndex="10"
                            Click="OnClose" />
                    <!-- here we inject the view -->
                    <ContentPresenter />
                </Grid>
        </Border>
    </Grid>
</UserControl>
