<UserControl x:Class="ADLMRateGen.View.MaterialPriceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ADLMRateGen.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Tag="SxSheet"
             d:DesignWidth="620" d:DesignHeight="640">
    <!-- Add or edit a material price, as a suite sheet (Richard's design,
         30 Sep 2026): the same sheet, fields and footer as Rate Composition and
         the custom-rate builder. -->
    <UserControl.Resources>
        <conv:BoolToStringConverter x:Key="BoolToStringConverter" />
    </UserControl.Resources>

    <Border Style="{StaticResource SxSheet}" Width="620" MaxHeight="760">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="24,24,24,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource SxSheetBtn}" Content="×" VerticalAlignment="Top"
                        Click="Close_Click" ToolTip="Close without saving" />
                <StackPanel>
                    <TextBlock Style="{StaticResource SxH2}"
                               Text="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Edit material|Add material'}" />
                    <TextBlock Style="{StaticResource SxLede}" Foreground="{DynamicResource SxInk3}"
                               Text="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Change it here and every rate built from it is repriced.|Not in the ADLM library? Add it; it stays on this PC.'}" />
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="24,0,24,24">
                <StackPanel>
                    <TextBlock Style="{StaticResource SxLabel}" Text="Name of material" />
                    <TextBox Style="{StaticResource SxField}" Margin="0,0,0,16"
                             Text="{Binding MaterialName}" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SxLabel}" Text="Unit" />
                            <TextBox Style="{StaticResource SxField}" Tag="e.g. m2, Bag, day"
                                     Text="{Binding MaterialUnit}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource SxLabel}">
                                <Run Text="Price" /><Run Text="{Binding CurrencyLabel, StringFormat=' ({0})', Mode=OneWay}"
                                                         Foreground="{DynamicResource SxInk3}" FontWeight="Normal" />
                            </TextBlock>
                            <TextBox Style="{StaticResource SxField}" TextAlignment="Right"
                                     Text="{Binding MaterialPrice, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource SxLabel}" Text="Category" />
                    <TextBox Style="{StaticResource SxField}" Tag="e.g. Cement and aggregates"
                             Text="{Binding NewMaterialCategory}" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Style="{StaticResource SxSheetFoot}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource SxBtnGhost}" Content="Cancel" Margin="0,0,10,0" Click="Close_Click" />
                    <Button Grid.Column="1"
                            Content="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Update the library|Save to the library'}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SxBtn}">
                                <Setter Property="Command" Value="{Binding SaveMaterialCommand}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Command" Value="{Binding UpdateMaterialCommand}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
