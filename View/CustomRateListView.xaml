<UserControl x:Class="ADLMRateGen.View.CustomRateListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ADLMRateGen.View"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <!-- Saved Custom Rates (Richard's design, 30 Sep 2026: savedScreen() in
         rategen-app.js). Same head, bar and table as View/Suite/TradeScreen.xaml.

         DataContext is CustomRateListViewModel: RatesView, CustomRates,
         SelectedRate, SearchTerm, FilterCommand, SortCommand, ViewRateCommand,
         DeleteRateCommand. There is no add command on this view model, so the
         design's "Add Custom Rate +" stays on the trade screens. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Head: title and the one-line promise -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,24,0">
                <TextBlock Style="{StaticResource SxH1}" Text="Saved Custom Rates" />
                <TextBlock Style="{StaticResource SxLede}" MaxWidth="720" HorizontalAlignment="Left"
                           Text="The rates you built. They stay on this PC and travel with your account, never into the ADLM library." />
            </StackPanel>
            <!-- Kept from the old screen: delete whichever row is selected -->
            <Button Grid.Column="1" Style="{StaticResource SxBtnGhost}" VerticalAlignment="Top"
                    Command="{Binding DeleteRateCommand}"
                    Content="Delete selected rate"
                    ToolTip="Select a row first. This removes the rate from this PC." />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SxPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Bar: find, then filter and sort -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="180" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource SxBox}" Margin="0,0,10,0">
                        <DockPanel>
                            <ContentControl Style="{StaticResource SxIcSm}" Tag="{StaticResource Ic.Search}"
                                            Foreground="{DynamicResource SxInk3}" Margin="0,0,8,0" />
                            <TextBox Style="{StaticResource SxBare}" Tag="Search your saved rates"
                                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource SxBtnGhost}" Margin="0,0,10,0"
                            Command="{Binding FilterCommand}" ToolTip="Filter the list">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource SxIcSm}" Tag="{StaticResource Ic.Filter}"
                                            Foreground="{DynamicResource SxInk3}" Margin="0,0,8,0" />
                            <TextBlock Text="Filter" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource SxBtnGhost}"
                            Command="{Binding SortCommand}" ToolTip="Change the order of the list">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Sort by" VerticalAlignment="Center" />
                            <Path Data="M0,0 L4.5,4.5 L9,0" Margin="10,0,0,0"
                                  Stroke="{DynamicResource SxInk3}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <DataGrid x:Name="Table" Grid.Row="1" Style="{StaticResource SxTable}"
                          ItemsSource="{Binding RatesView}"
                          SelectedItem="{Binding SelectedRate}"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="TITLE" Width="*" MinWidth="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource SxCell}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Title}" ToolTip="{Binding Title}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="DESCRIPTION" Width="2*" MinWidth="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- Clicking the wording opens the rate for editing -->
                                    <TextBlock Style="{StaticResource SxCellDesc}"
                                               Text="{Binding Description}" ToolTip="{Binding Description}">
                                        <TextBlock.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.ViewRateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          CommandParameter="{Binding}" />
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="OVERHEAD %" Width="Auto" MinWidth="104"
                                            HeaderStyle="{StaticResource SxTableHeaderRight}"
                                            Binding="{Binding OverheadPercent}"
                                            ElementStyle="{StaticResource SxCellNum}" />
                        <DataGridTextColumn Header="PROFIT %" Width="Auto" MinWidth="90"
                                            HeaderStyle="{StaticResource SxTableHeaderRight}"
                                            Binding="{Binding ProfitPercent}"
                                            ElementStyle="{StaticResource SxCellNum}" />
                        <DataGridTextColumn Header="GRAND TOTAL" Width="Auto" MinWidth="128"
                                            HeaderStyle="{StaticResource SxTableHeaderRight}"
                                            Binding="{Binding GrandTotal, Converter={StaticResource MoneyConv}}"
                                            ElementStyle="{StaticResource SxCellNumB}" />
                        <DataGridTextColumn Header="CREATED" Width="Auto" MinWidth="110"
                                            Binding="{Binding CreatedDate, StringFormat='d MMM yyyy'}"
                                            ElementStyle="{StaticResource SxCellMuted}" />
                        <DataGridTemplateColumn Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SxDel}" HorizontalAlignment="Right"
                                            Margin="0,-4,0,-4"
                                            ToolTip="Delete this rate"
                                            AutomationProperties.Name="Delete"
                                            Click="DeleteRow_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty is a state: say why, in the table's place -->
                <TextBlock Grid.Row="1" VerticalAlignment="Top" Margin="0,56,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SxNone}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CustomRates.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="Nothing saved yet." /> <Run Text="Add Custom Rate" FontWeight="SemiBold" /><Run Text=" builds one, from scratch or from a sentence you type." />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
