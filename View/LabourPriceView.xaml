<UserControl x:Class="ADLMRateGen.View.LabourPriceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ADLMRateGen.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Tag="SxSheet"
             d:DesignWidth="620" d:DesignHeight="640">
    <!-- Add or edit a labour price, as a suite sheet (Richard's design,
         30 Sep 2026): the same sheet, fields and footer as Rate Composition and
         the custom-rate builder. -->
    <UserControl.Resources>
        <conv:BoolToStringConverter x:Key="BoolToStringConverter" />
    </UserControl.Resources>

    <Border Style="{StaticResource SxSheet}" Width="620" MaxHeight="760">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="24,24,24,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource SxSheetBtn}" Content="×" VerticalAlignment="Top"
                        Click="Close_Click" ToolTip="Close without saving" />
                <StackPanel>
                    <TextBlock Style="{StaticResource SxH2}"
                               Text="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Edit labour|Add labour'}" />
                    <TextBlock Style="{StaticResource SxLede}" Foreground="{DynamicResource SxInk3}"
                               Text="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Change it here and every rate built from it is repriced.|Not in the ADLM library? Add it; it stays on this PC.'}" />
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="24,0,24,24">
                <StackPanel>
                    <TextBlock Style="{StaticResource SxLabel}" Text="Name of labour" />
                    <TextBox Style="{StaticResource SxField}" Margin="0,0,0,16"
                             Text="{Binding LabourName, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SxLabel}" Text="Unit" />
                            <TextBox Style="{StaticResource SxField}" Tag="e.g. m2, Bag, day"
                                     Text="{Binding LabourUnit}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource SxLabel}">
                                <Run Text="Price" /><Run Text="{Binding CurrencyLabel, StringFormat=' ({0})', Mode=OneWay}"
                                                         Foreground="{DynamicResource SxInk3}" FontWeight="Normal" />
                            </TextBlock>
                            <TextBox Style="{StaticResource SxField}" TextAlignment="Right"
                                     Text="{Binding LabourPrice, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource SxLabel}" Text="Category" />
                    <TextBox Style="{StaticResource SxField}" Tag="e.g. Cement and aggregates"
                             Text="{Binding NewLabourCategory}" />

                    <TextBlock Style="{StaticResource SxLabel}" Text="Note" Margin="0,16,0,5" />
                    <TextBox Style="{StaticResource SxField}" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" MinHeight="84" MaxHeight="150"
                             VerticalScrollBarVisibility="Auto"
                             Tag="What it is and what it produces in a day"
                             ToolTip="What the item is and what it produces in a day, so anyone pricing against this rate can see what it has to cover."
                             Text="{Binding NewLabourNote, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- The library's own specification and output for this item. Read-only:
                         it informs the price without competing with the fields, and it is
                         hidden when nothing is recorded. -->
                    <Border Margin="0,24,0,0" Padding="16" CornerRadius="14" BorderThickness="1"
                            Background="{DynamicResource SxBgAlt}" BorderBrush="{DynamicResource SxLine2}"
                            Visibility="{Binding HasSpec, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SxH3}" FontSize="13.5" Text="Specification and expected output" Margin="0,0,0,8" />
                            <TextBlock Style="{StaticResource SxText}" FontSize="12.5" TextWrapping="Wrap" Text="{Binding Spec.Spec}" />
                            <TextBlock Style="{StaticResource SxMuted}" FontSize="11" Margin="0,12,0,0" Text="EXPECTED OUTPUT" />
                            <TextBlock Style="{StaticResource SxText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Text="{Binding Spec.Output}" />
                            <!-- Never shown without the basis: soil, haul and gang move these
                                 figures more than the machine does. -->
                            <TextBlock Style="{StaticResource SxMuted}" Margin="0,6,0,0" Text="{Binding Spec.Basis}" />
                            <TextBlock Style="{StaticResource SxMuted}" Margin="0,10,0,0">
                                <Run Text="Running: " FontWeight="SemiBold" /><Run Text="{Binding Spec.Running, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource SxMuted}" FontSize="11" FontStyle="Italic" Margin="0,10,0,0"
                                       Text="{Binding Spec.Source}" />
                            <TextBlock Style="{StaticResource SxMuted}" FontSize="11" Margin="0,10,0,0"
                                       Text="Indicative only. Site conditions, operator and gang make-up change these figures substantially; treat them as a sense check on your rate, not a guarantee." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Style="{StaticResource SxSheetFoot}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource SxBtnGhost}" Content="Cancel" Margin="0,0,10,0" Click="Close_Click" />
                    <Button Grid.Column="1"
                            Content="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Update the library|Save to the library'}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SxBtn}">
                                <Setter Property="Command" Value="{Binding SaveLabourCommand}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Command" Value="{Binding UpdateLabourCommand}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
