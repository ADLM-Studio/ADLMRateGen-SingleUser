<UserControl x:Class="ADLMCivilPlugin.Controls.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:ADLMRateGen.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:ADLMRateGen.Services"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             mc:Ignorable="d"
             Height="56"
             Loaded="Header_Loaded">

    <UserControl.Resources>
        <conv:CountToBoolConverter x:Key="CountToBool" />
        <conv:BoolToVis x:Key="BoolToVisibility" />
        <conv:EmptyCollectionToVisibility x:Key="EmptyCollectionToVisibility" />

        <!-- The suite's top bar (Richard's design, 30 Sep 2026): 56px, a hairline
             under it, outlined 10px controls, 32px icon buttons in ink-2. -->
        <Style x:Key="HeaderSurfaceBorderStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource SxBg}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource SxLine2}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="10" />
        </Style>

        <Style x:Key="HeaderActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SxIconBtn}" />

        <Style x:Key="HeaderCurrencyComboStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource TopNavComboBoxStyle}">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="{DynamicResource SxInk2}" />
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Padding"
                    Value="0" />
        </Style>
    </UserControl.Resources>

    <UserControl.DataContext>
        <Binding Path="DataContext"
                 RelativeSource="{RelativeSource AncestorType=Window}" />
    </UserControl.DataContext>

    <Border Padding="22,0"
            Background="{DynamicResource SxBg}"
            BorderBrush="{DynamicResource SxLine}"
            BorderThickness="0,0,0,1">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="560" />
                <ColumnDefinition Width="*" MinWidth="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SearchSurface"
                    Grid.Column="0"
                    Height="36"
                    Padding="12,0"
                    Style="{StaticResource HeaderSurfaceBorderStyle}">
                <Grid DataContext="{Binding GlobalSearch}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Search}" Foreground="{DynamicResource SxInk3}" Margin="0,0,8,0" />

                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontFamily="{StaticResource SxFont}"
                                 FontSize="13"
                                 Foreground="{DynamicResource SxInk}"
                                 CaretBrush="{DynamicResource SxInk}"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,1,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Text="Search every rate in the library"
                                   FontFamily="{StaticResource SxFont}"
                                   FontSize="13"
                                   Foreground="{DynamicResource SxInk3}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}"
                                                     Value="0">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border Grid.Column="2"
                            Margin="8,0,0,0"
                            Padding="7,2"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SxBgAlt}"
                            BorderBrush="{DynamicResource SxLine}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock Text="Ctrl + F"
                                   FontFamily="{StaticResource SxFont}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SxInk3}" />
                    </Border>

                    <Popup IsOpen="{Binding Suggestions.Count, Converter={StaticResource CountToBool}, Mode=OneWay}"
                           PlacementTarget="{Binding ElementName=SearchSurface}"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource SxBg}"
                                BorderBrush="{DynamicResource SxLine2}"
                                BorderThickness="1"
                                CornerRadius="14"
                                MinWidth="{Binding ElementName=SearchSurface, Path=ActualWidth}"
                                Padding="6"
                                Effect="{x:Null}">
                            <ListBox x:Name="SuggestionList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemsSource="{Binding Suggestions}"
                                     MouseLeftButtonUp="SuggestionList_Click">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Display}"
                                                       FontFamily="{StaticResource SxFont}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SxInk}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="18,0,0,0"
                                                       Text="{Binding Category}"
                                                       FontFamily="{StaticResource SxFont}"
                                                       Foreground="{DynamicResource SxInk3}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Height="30"
                        Margin="0,0,8,0"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource HeaderSurfaceBorderStyle}"
                        CornerRadius="15">
                    <ComboBox Width="84"
                              Style="{StaticResource HeaderCurrencyComboStyle}"
                              ItemsSource="{Binding Source={x:Static services:CurrencyService.Instance}, Path=Supported}"
                              SelectedItem="{Binding Source={x:Static services:CurrencyService.Instance}, Path=Selected}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Image Width="16"
                                           Height="11"
                                           Margin="0,0,6,0"
                                           Source="{Binding Converter={StaticResource CurrencyToFlagConverter}}" />
                                    <TextBlock Text="{Binding}"
                                               FontFamily="{StaticResource SxFont}"
                                               FontSize="11"
                                               Foreground="{DynamicResource SxInk}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Border>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                    <!-- Sync from Cloud — moved here from the sidebar so every
                         app-wide action sits in one group. -->
                    <Button Margin="0,0,2,0"
                            Style="{StaticResource HeaderActionButtonStyle}"
                            Command="{Binding RefreshCloudDataCommand}">
                        <Button.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="Sync from Cloud  (F5)"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CloudSyncStatus}"
                                               Opacity="0.8" />
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                        <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Refresh}" Foreground="{DynamicResource SxInk2}" />
                    </Button>

                    <!-- Welcome-banner toggle — collapsing the banner hands its
                         height to the rate table, roughly doubling visible rows. -->
                    <Button Margin="0,0,4,0"
                            Style="{StaticResource HeaderActionButtonStyle}"
                            Command="{Binding ToggleWelcomeBannerCommand}">
                        <Button.ToolTip>
                            <ToolTip>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text"
                                                    Value="Show welcome banner" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWelcomeBannerVisible}"
                                                             Value="True">
                                                    <Setter Property="Text"
                                                            Value="Hide welcome banner — more room for rates" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </ToolTip>
                        </Button.ToolTip>
                        <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Eye}" Foreground="{DynamicResource SxInk2}" />
                    </Button>

                    <!-- Keyboard shortcuts sheet (also F1 / Ctrl+/); MainWindow binds Help. -->
                    <Button Margin="0,0,4,0"
                            Style="{StaticResource HeaderActionButtonStyle}"
                            Command="ApplicationCommands.Help"
                            ToolTip="Keyboard shortcuts (F1 or Ctrl+/)">
                        <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Keyboard}" Foreground="{DynamicResource SxInk2}" />
                    </Button>

                    <Button x:Name="ColorModeButton"
                            Margin="0,0,4,0"
                            Style="{StaticResource HeaderActionButtonStyle}"
                            Click="ColorModeButton_Click">
                        <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Moon}" Foreground="{DynamicResource SxInk2}" x:Name="ColorModeIcon" />
                    </Button>

                    <Button x:Name="ResetAllEditsButton"
                            Margin="0,0,4,0"
                            Style="{StaticResource HeaderActionButtonStyle}"
                            Click="ResetAllEditsButton_Click"
                            ToolTip="Reset all rate edits app-wide — restores every section's quantities to shipped defaults and syncs the reset to QUIV / HERON.">
                        <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Undo}" Foreground="{DynamicResource SxInk2}" />
                    </Button>

                    <!-- Library Undo — restores an earlier copy of the material and
                         labour libraries. Deliberately NOT the Undo arrow: that one
                         belongs to Reset all rate edits above, and two different
                         destructive actions must not share a symbol. ClockRotateLeft
                         reads as "go back to an earlier point", which is what this is.
                         Only shown on the Library screen, since that is what it acts on. -->
                    <Grid Visibility="{Binding IsLibraryShellActive, Converter={StaticResource BoolToVisibility}}">
                        <Button x:Name="LibraryUndoButton"
                                Margin="0,0,4,0"
                                Style="{StaticResource HeaderActionButtonStyle}"
                                Command="{Binding LibraryShellViewModel.OpenArchiveCommand}"
                                ToolTip="Undo library changes — go back to an earlier copy of the material and labour libraries.">
                            <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.History}" Foreground="{DynamicResource SxInk2}" />
                        </Button>

                        <Popup IsOpen="{Binding LibraryShellViewModel.IsArchiveOpen, Mode=TwoWay}"
                               StaysOpen="False"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource SxBg}"
                                    BorderBrush="{DynamicResource SxInk}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Width="380">
                                <StackPanel>
                                    <TextBlock Text="Restore an earlier library"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6" />
                                    <TextBlock Text="Pick a point to go back to. The current library is archived first, so a restore can itself be undone."
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Opacity="0.75"
                                               Margin="0,0,0,8" />
                                    <ListBox ItemsSource="{Binding LibraryShellViewModel.Archives}"
                                             SelectedItem="{Binding LibraryShellViewModel.SelectedArchive, Mode=TwoWay}"
                                             DisplayMemberPath="Label"
                                             MaxHeight="220" />
                                    <TextBlock Text="No earlier copies yet."
                                               FontSize="11"
                                               Opacity="0.7"
                                               Margin="2,6,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LibraryShellViewModel.Archives.Count}"
                                                                 Value="0">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Command="{Binding LibraryShellViewModel.RestoreCommand}"
                                            Style="{DynamicResource PrimaryButton}"
                                            HorizontalAlignment="Right"
                                            Margin="0,10,0,0"
                                            Padding="14,4">
                                        <TextBlock Text="Restore"
                                                   Style="{StaticResource BtnText}" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Grid>
                        <Button x:Name="BellButton"
                                Style="{StaticResource HeaderActionButtonStyle}"
                                Command="{Binding ToggleNotificationsCommand}"
                                ToolTip="Updates and admin notifications">
                            <Grid>
                                <ContentControl Style="{StaticResource SxIc}" Tag="{StaticResource Ic.Bell}" Foreground="{DynamicResource SxInk2}" HorizontalAlignment="Center" />
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{DynamicResource SxAccent}"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Margin="0,-2,-3,0"
                                         Visibility="{Binding HasPriceNotifications, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Button>

                        <Popup x:Name="NotificationsPopup"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=BellButton}"
                               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                               IsOpen="{Binding IsNotificationsOpen, Mode=TwoWay}"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               StaysOpen="False"
                               Closed="NotificationsPopup_Closed">
                            <Border Width="332"
                                    Margin="0,12,0,0"
                                    Padding="16"
                                    Background="{DynamicResource SxBg}"
                                    BorderBrush="{DynamicResource SxLine2}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Effect="{x:Null}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <DockPanel>
                                        <TextBlock Text="Notifications"
                                                   FontFamily="{StaticResource SxFont}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SxInk}" />
                                        <Button DockPanel.Dock="Right"
                                                Width="28"
                                                Height="28"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Command="{Binding PlacementTarget.DataContext.ToggleNotificationsCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                ToolTip="Close notifications">
                                            <fa:IconBlock Icon="Times"
                                                          Width="12"
                                                          Height="12"
                                                          Foreground="{DynamicResource SxInk3}" />
                                        </Button>
                                    </DockPanel>

                                    <StackPanel Grid.Row="1">

                                        <!-- A hidden price review is the one notification
                                             that has to be reachable again, so it is pinned
                                             here rather than added to the message list. -->
                                        <Border Margin="0,10,0,0"
                                                Padding="12"
                                                CornerRadius="14"
                                                Background="{DynamicResource SxBg}"
                                                BorderBrush="{DynamicResource SxInk}"
                                                BorderThickness="1"
                                                Visibility="{Binding LibraryShellViewModel.HasHiddenPriceConflicts, Converter={StaticResource BoolVis}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="30"
                                                        Height="30"
                                                        Background="{DynamicResource SxBgAlt}"
                                                        CornerRadius="10"
                                                        VerticalAlignment="Top">
                                                    <fa:IconBlock Icon="Tags"
                                                                  Width="12"
                                                                  Height="12"
                                                                  Foreground="{DynamicResource SxInk}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1"
                                                            Margin="12,0,10,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding LibraryShellViewModel.PriceConflictSummary}"
                                                               TextWrapping="Wrap"
                                                               FontFamily="{StaticResource SxFont}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SxInk}" />
                                                    <TextBlock Text="You put this review away."
                                                               FontFamily="{StaticResource SxFont}"
                                                               FontSize="10.5"
                                                               Opacity="0.7"
                                                               Foreground="{DynamicResource SxInk}" />
                                                </StackPanel>

                                                <!-- Compact: the popup is narrow, so the shared
                                                     secondary style is scaled down here. -->
                                                <Button Grid.Column="2"
                                                        Click="ReopenPriceReview_Click"
                                                        Style="{DynamicResource SecondaryButton}"
                                                        Height="30"
                                                        MinWidth="76"
                                                        FontSize="12"
                                                        Padding="10,0"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Open the price review in the library">
                                                    <TextBlock Text="Review"
                                                               FontFamily="{StaticResource SxFont}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold" />
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <TextBlock Margin="0,8,0,0"
                                                   Text="You are all caught up."
                                                   FontFamily="{StaticResource SxFont}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SxInk3}"
                                                   Visibility="{Binding Notifications.Count, Converter={StaticResource EmptyCollectionToVisibility}}" />
                                    </StackPanel>

                                    <ScrollViewer Grid.Row="2"
                                                  Margin="0,12,0,0"
                                                  MaxHeight="260"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Notifications}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,10"
                                                            Padding="12"
                                                            Background="{DynamicResource SxBg}"
                                                            BorderBrush="{DynamicResource SxLine2}"
                                                            BorderThickness="1"
                                                            CornerRadius="14">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Width="30"
                                                                    Height="30"
                                                                    Background="{DynamicResource SxBgAlt}"
                                                                    CornerRadius="10"
                                                                    VerticalAlignment="Top">
                                                                <fa:IconBlock Icon="Bell"
                                                                              Width="12"
                                                                              Height="12"
                                                                              Foreground="{DynamicResource SxAction}"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                            </Border>

                                                            <TextBlock Grid.Column="1"
                                                                       Margin="12,0,10,0"
                                                                       Text="{Binding}"
                                                                       TextWrapping="Wrap"
                                                                       FontFamily="{StaticResource SxFont}"
                                                                       FontSize="11.5"
                                                                       Foreground="{DynamicResource SxInk}" />

                                                            <Button Grid.Column="2"
                                                                    Width="24"
                                                                    Height="24"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Cursor="Hand"
                                                                    Command="{Binding PlacementTarget.DataContext.DismissNotificationCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                                    CommandParameter="{Binding}">
                                                                <fa:IconBlock Icon="Times"
                                                                              Width="10"
                                                                              Height="10"
                                                                              Foreground="{DynamicResource SxInk3}" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <Button Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="0"
                        Click="ProfileButton_Click"
                        ToolTip="Open your ADLM profile">
                    <Border Padding="4,4,12,4"
                            Style="{StaticResource HeaderSurfaceBorderStyle}"
                            CornerRadius="17">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="26"
                                  Height="26">
                                <Ellipse Fill="{DynamicResource SxAction}" />
                                <ContentControl Style="{StaticResource SxIcSm}" Tag="{StaticResource Ic.Profile}"
                                                Foreground="{DynamicResource SxActionInk}" Width="14" Height="14"
                                                HorizontalAlignment="Center" />
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding CurrentUser.AvatarSource, Mode=OneWay}"
                                                    Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>

                            <StackPanel Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUser.DisplayName, Mode=OneWay}"
                                           MaxWidth="170"
                                           TextTrimming="CharacterEllipsis"
                                           FontFamily="{StaticResource SxFont}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="{DynamicResource SxInk}" />
                                <TextBlock Text="{Binding CurrentUser.Email, Mode=OneWay}"
                                           MaxWidth="170"
                                           TextTrimming="CharacterEllipsis"
                                           FontFamily="{StaticResource SxFont}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource SxInk3}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
