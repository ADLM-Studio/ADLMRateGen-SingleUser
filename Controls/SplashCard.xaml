<UserControl x:Class="ADLMRateGen.Controls.SplashCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The ADLM product splash, RateGen's frame (Richard's design, ADLM Designs
         543:1221; splash.css / splash.js in the design repo).

         Laid out in design pixels on the 815 x 545 Figma frame and scaled as one
         piece by the Viewbox, so nothing shifts or stretches at any size. Every
         position is the number Richard drew: plate 333 wide, lockup at 46,46 and
         120 wide, wordmark at 46,107 and 41 tall (height only; it is drawn
         artwork), version chip at 46,164, promise at 46,205, status at 46,248,
         footer at 46,475.

         The sign-in is the same card: with Form set, the form takes the middle of
         the plate and everything else stays where it is, so the window settles
         rather than switching. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="815" Height="545">
            <Border x:Name="Frame" CornerRadius="16" BorderThickness="1" BorderBrush="#805AA0FF"
                    Background="#0A1420" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,813,543" RadiusX="15" RadiusY="15" />
                    </Grid.Clip>

                    <!-- the artwork runs the full frame; the plate is drawn over it -->
                    <Rectangle>
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/ADLMRateGen;component/Resources/Suite/sp-rategen.jpg"
                                        Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- the plate -->
                    <Rectangle Width="333" HorizontalAlignment="Left">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0.31,0" EndPoint="0.69,1">
                                <GradientStop Color="#0D2A5E" Offset="0" />
                                <GradientStop Color="#0A1F45" Offset="0.48" />
                                <GradientStop Color="#07152F" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Canvas x:Name="Plate" Width="333" HorizontalAlignment="Left" Background="Transparent">
                        <Image Canvas.Left="46" Canvas.Top="46" Width="120"
                               Source="{StaticResource Logo.Dark}" />
                        <Image Canvas.Left="46" Canvas.Top="107" Height="41" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="/ADLMRateGen;component/Resources/Suite/wm-rategen.png" />
                        <Border Canvas.Left="46" Canvas.Top="164" Width="38.7" Height="16.4"
                                CornerRadius="5" BorderThickness="1"
                                BorderBrush="#8C78BEFF" Background="#29239CFF">
                            <TextBlock x:Name="VersionText" FontFamily="{StaticResource SxFont}" FontSize="8.5"
                                       FontWeight="SemiBold" Foreground="#9FD2FF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- the splash: one promise and what it is doing -->
                        <StackPanel x:Name="Splash" Canvas.Left="46" Canvas.Top="205">
                            <TextBlock Width="216" FontFamily="{StaticResource SxFont}" FontSize="9.2" LineHeight="11.4"
                                       LineStackingStrategy="BlockLineHeight" Foreground="#DBFFFFFF" TextWrapping="Wrap">
                                <Run Text="Rate build-ups with material and labour." /><LineBreak />
                                <Run Text="Priced for the zone you are working in." />
                            </TextBlock>
                            <TextBlock x:Name="StatusText" Margin="0,20,0,0" FontFamily="{StaticResource SxFont}"
                                       FontSize="8.4" FontWeight="Medium" Foreground="#F5853F"
                                       Text="Starting up…" />
                        </StackPanel>

                        <!-- the sign-in, in the same place -->
                        <ContentPresenter x:Name="FormHost" Canvas.Left="46" Canvas.Top="205" Width="241"
                                          Visibility="Collapsed" />

                        <TextBlock Canvas.Left="46" Canvas.Top="475" Width="190" FontFamily="{StaticResource SxFont}"
                                   FontSize="7.4" LineHeight="9.4" LineStackingStrategy="BlockLineHeight"
                                   Foreground="#8CFFFFFF" TextWrapping="Wrap">
                            <Run x:Name="CopyrightRun" /><LineBreak />
                            <Run Text="For more details and legal notices, visit" /><LineBreak />
                            <Run Text="adlmstudio.net" />
                        </TextBlock>
                    </Canvas>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
