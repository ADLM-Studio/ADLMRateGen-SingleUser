<Window x:Class="ADLMRateGen.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:view="clr-namespace:ADLMRateGen.View"
        Title="ADLM RateGen"
        Width="895"
        Height="625"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <!-- The sign-in is the splash card (Richard's design): the same frame the
         app opened on, with the form in the plate. Drag it anywhere that is not
         a field; minimise and close sit over the artwork. -->
    <Window.Resources>
        <Style x:Key="Chrome" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="#D9FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="8" Background="#590A1420">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#990A1420" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="40" MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <view:SignInUserControl>
            <view:SignInUserControl.Effect>
                <DropShadowEffect BlurRadius="60" ShadowDepth="20" Direction="270" Opacity="0.6" Color="Black" />
            </view:SignInUserControl.Effect>
        </view:SignInUserControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0">
            <Button Style="{StaticResource Chrome}" ToolTip="Minimise" Click="Minimize_Click" Content="&#x2013;" />
            <Button Style="{StaticResource Chrome}" ToolTip="Close" Click="Close_Click" Content="&#x2715;" Margin="6,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
